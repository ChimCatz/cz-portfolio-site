---
// Shared layout for long-form pages (Insights, Data Studies):
// eyebrow + title + intro, banner, then 75% article / 25% sticky sidebar,
// and a "Next ..." link at the bottom.
//
// Sidebar content goes in the "side" slot as one or more `.side-block`s.
// On phones each block becomes its own panel: blocks with `side-first`
// sit above the article, the rest below it.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import { formatDate } from '../lib/reading';

interface Props {
  title: string;
  summary: string;
  /** Publish date in the eyebrow; pages without one (projects) show `kicker` instead */
  date?: Date;
  kicker?: string;
  minutes: number;
  banner: ImageMetadata;
  bannerAlt: string;
  /** Section the page belongs to, e.g. { label: 'Insights', href: '/insights' } */
  section: { label: string; href: string };
  next?: { label: string; href: string; title: string; summary: string };
}

const { title, summary, date, kicker, minutes, banner, bannerAlt, section, next } = Astro.props;
const hasSide = Astro.slots.has('side');
---

<BaseLayout title={`${title} | CZ Catalan`} description={summary} dimBackground>
  <article class="container reading">
    <header class="reading-head">
      <p class="eyebrow reading-meta">
        <a href={section.href}>{section.label}</a>
        {date ? <time datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time> : <span>{kicker}</span>}
        <span>{minutes} min read</span>
      </p>
      <h1>{title}</h1>
      <p class="reading-intro">{summary}</p>
    </header>

    <div class="reading-banner">
      <Image
        src={banner}
        alt={bannerAlt}
        widths={[640, 960, 1280, 1600]}
        sizes="(max-width: 1120px) calc(100vw - 32px), 1040px"
        loading="eager"
      />
    </div>

    <div class:list={['reading-layout', { 'has-side': hasSide }]}>
      <div class="reading-body">
        <slot />
      </div>

      {hasSide && (
        <aside class="reading-side" aria-label="Summary">
          <slot name="side" />
        </aside>
      )}
    </div>

    {next && (
      <nav class="next-link" aria-label={next.label}>
        <span class="eyebrow">{next.label}</span>
        <a href={next.href}>
          <span class="next-title">{next.title} <span class="next-arrow" aria-hidden="true">→</span></span>
          <span class="next-summary">{next.summary}</span>
        </a>
      </nav>
    )}
  </article>
</BaseLayout>

<style>
  .reading {
    padding-top: calc(var(--header-h) + clamp(32px, 6vh, 64px));
    padding-bottom: 96px;
  }

  /* Title block */
  .reading-head {
    max-width: 880px;
  }

  .reading-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
  }

  .reading-meta a {
    text-decoration: none;
  }

  .reading-meta a:hover {
    color: var(--purple-300);
  }

  /* The dot belongs to the item after it, so a wrapped line never ends on one */
  .reading-meta > * + *::before {
    content: '·';
    margin-right: 10px;
    color: var(--text-faint);
  }

  .reading-head h1 {
    margin-top: 14px;
    font-size: clamp(1.9rem, 4vw, 3rem);
    text-wrap: balance;
  }

  .reading-intro {
    margin-top: 18px;
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    line-height: 1.7;
    color: var(--text-muted);
  }

  /* Banner (never cropped: some banners have text near the edges) */
  .reading-banner {
    margin-top: clamp(28px, 4vh, 40px);
    overflow: hidden;
    border-radius: var(--radius);
    border: 1px solid var(--line-strong);
    box-shadow: 0 24px 60px -28px var(--glow);
  }

  .reading-banner img {
    width: 100%;
  }

  /* 75% article / 25% sidebar */
  .reading-layout {
    margin-top: clamp(36px, 5vh, 56px);
  }

  .reading-layout.has-side {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 1fr);
    column-gap: clamp(32px, 4vw, 48px);
    align-items: start;
  }

  .reading-side {
    position: sticky;
    top: calc(var(--header-h) + 24px);
    background: rgba(13, 10, 22, 0.72);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 18px;
    /* Never taller than the screen; scrolls inside on short laptop screens */
    max-height: calc(100vh - var(--header-h) - 48px);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--line-strong) transparent;
  }

  /* Sidebar pieces, styled here so every reading page matches */
  .reading-side :global(.side-block + .side-block) {
    margin-top: 18px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
  }

  .reading-side :global(.side-heading) {
    margin-bottom: 12px;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--purple-400);
  }

  .reading-side :global(.tool-list) {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .reading-side :global(.tool-list li) {
    padding: 3px 11px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: rgba(124, 58, 237, 0.1);
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 500;
    line-height: 1.5;
    color: var(--purple-300);
  }

  /* "At a glance" rows and sidebar buttons */
  .reading-side :global(.side-section + .side-section) {
    margin-top: 18px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
  }

  .reading-side :global(.facts) {
    margin: 0;
  }

  .reading-side :global(.facts div + div) {
    margin-top: 10px;
  }

  .reading-side :global(.facts dt) {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .reading-side :global(.facts dd) {
    margin: 1px 0 0;
    font-size: 0.88rem;
    line-height: 1.45;
    color: var(--text);
  }

  .reading-side :global(.side-actions) {
    display: grid;
    gap: 8px;
  }

  .reading-side :global(.side-actions .btn) {
    justify-content: flex-start;
    gap: 10px;
    padding: 0.7em 1.1em;
    font-size: 0.85rem;
    line-height: 1.25;
  }

  .reading-side :global(.side-actions svg) {
    flex: none;
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .reading-side :global(.side-actions small) {
    display: block;
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 500;
    opacity: 0.8;
  }

  /* Article text (rendered from Markdown, so styles reach in with :global) */
  .reading-body :global(p),
  .reading-body :global(li) {
    color: var(--text-soft);
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .reading-body :global(p + p) {
    margin-top: 1.1em;
  }

  .reading-body :global(strong) {
    color: var(--purple-300);
    font-weight: 600;
  }

  .reading-body :global(a:not([class])) {
    color: var(--purple-400);
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }

  .reading-body :global(a:not([class]):hover) {
    color: var(--purple-300);
  }

  .reading-body :global(figure) {
    margin: 40px 0;
  }

  .reading-body :global(figure img) {
    margin-inline: auto;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line);
  }

  .reading-body :global(figcaption) {
    margin-top: 12px;
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--text-muted);
  }

  /* ---------- Long-form article content (opt-in: wrap it in .prose) ---------- */

  /* Note above the article and footnote at the end */
  .reading-body :global(.prose-note) {
    margin-bottom: 36px;
    padding: 14px 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: rgba(124, 58, 237, 0.06);
  }

  .reading-body :global(.prose-footnote) {
    margin-top: 56px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }

  .reading-body :global(.prose-note),
  .reading-body :global(.prose-footnote) {
    font-size: 0.92rem;
    line-height: 1.7;
    color: var(--text-muted);
  }

  .reading-body :global(.prose-note strong),
  .reading-body :global(.prose-footnote strong) {
    color: var(--text);
  }

  .reading-body :global(.prose h2) {
    margin: 56px 0 18px;
    font-size: clamp(1.4rem, 2.6vw, 1.85rem);
    line-height: 1.2;
    text-wrap: balance;
  }

  .reading-body :global(.prose > h2:first-child),
  .reading-body :global(.prose-note + h2) {
    margin-top: 0;
  }

  .reading-body :global(.prose h2 + p) {
    margin-top: 0;
  }

  /* Callouts ("Study snapshot", "Key read", ...) */
  .reading-body :global(.prose blockquote) {
    margin: 28px 0;
    padding: 16px 20px;
    border: 1px solid var(--line);
    border-left: 3px solid var(--purple-500);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    background: rgba(124, 58, 237, 0.08);
  }

  .reading-body :global(.prose blockquote p) {
    font-size: 0.98rem;
    line-height: 1.7;
  }

  .reading-body :global(.prose blockquote + p) {
    margin-top: 0;
  }

  /* Lists */
  .reading-body :global(.prose ul),
  .reading-body :global(.prose ol) {
    margin: 18px 0;
    padding-left: 1.3em;
  }

  .reading-body :global(.prose li + li) {
    margin-top: 8px;
  }

  .reading-body :global(.prose li::marker) {
    color: var(--purple-400);
  }

  .reading-body :global(.prose code) {
    padding: 1px 7px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--surface);
    font-size: 0.9em;
    color: var(--purple-300);
    overflow-wrap: anywhere;
  }

  /* Tables (wrapped by rehype-figure in .table-wrap, which scrolls sideways if needed) */
  .reading-body :global(.prose .table-wrap) {
    margin: 28px 0;
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
  }

  .reading-body :global(.prose table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .reading-body :global(.prose th),
  .reading-body :global(.prose td) {
    padding: 10px 14px;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--line);
    color: var(--text-soft);
  }

  .reading-body :global(.prose th) {
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--purple-300);
    background: rgba(124, 58, 237, 0.08);
    white-space: nowrap;
  }

  .reading-body :global(.prose tr:last-child td) {
    border-bottom: 0;
  }

  .reading-body :global(.prose td:first-child) {
    color: var(--text);
    font-weight: 500;
  }

  /* Two images side by side */
  .reading-body :global(.prose .figure-row) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin: 40px 0;
  }

  .reading-body :global(.prose .figure-row figure) {
    margin: 0;
  }

  /* Thumbnail gallery */
  .reading-body :global(.prose .gallery) {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin: 24px 0 40px;
  }

  .reading-body :global(.prose .gallery img) {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 8px;
    border: 1px solid var(--line);
    transition: border-color 0.2s, transform 0.2s;
  }

  .reading-body :global(.prose .gallery img:hover) {
    border-color: var(--purple-400);
    transform: translateY(-2px);
  }

  /* Collapsible question cards */
  .reading-body :global(.prose details) {
    margin-top: 12px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: rgba(13, 10, 22, 0.6);
  }

  .reading-body :global(.prose details[open]) {
    border-color: var(--line-strong);
  }

  .reading-body :global(.prose summary) {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 14px 44px 14px 16px;
    position: relative;
    list-style: none;
    cursor: pointer;
    font-family: var(--font-display);
    font-size: 1.02rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--text);
  }

  .reading-body :global(.prose summary::-webkit-details-marker) {
    display: none;
  }

  .reading-body :global(.prose summary::after) {
    content: '+';
    position: absolute;
    right: 18px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 1.3rem;
    font-weight: 400;
    color: var(--purple-400);
  }

  .reading-body :global(.prose details[open] > summary::after) {
    content: '\2212';
  }

  .reading-body :global(.prose summary:hover) {
    color: var(--purple-300);
  }

  .reading-body :global(.prose .q-label) {
    flex: none;
    min-width: 3.2em;
    padding: 1px 8px;
    border-radius: 999px;
    background: rgba(124, 58, 237, 0.18);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-align: center;
    color: var(--purple-300);
  }

  .reading-body :global(.prose details > :not(summary)) {
    margin-inline: 16px;
  }

  .reading-body :global(.prose details > summary + *) {
    margin-top: 4px;
  }

  .reading-body :global(.prose details > :last-child) {
    margin-bottom: 18px;
  }

  .reading-body :global(.prose details figure),
  .reading-body :global(.prose details .figure-row) {
    margin: 24px 16px;
  }

  @media (max-width: 600px) {
    .reading-body :global(.prose .figure-row) {
      grid-template-columns: minmax(0, 1fr);
    }

    .reading-body :global(.prose .gallery) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .reading-body :global(.prose summary) {
      font-size: 0.96rem;
    }
  }

  /* Next link */
  .next-link {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px 40px;
    margin-top: 72px;
    padding-top: 28px;
    border-top: 1px solid var(--line);
  }

  .next-link .eyebrow {
    flex: none;
    padding-top: 4px;
  }

  .next-link a {
    display: flex;
    flex-direction: column;
    max-width: 620px;
    text-align: right;
    text-decoration: none;
  }

  .next-title {
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    font-weight: 600;
    line-height: 1.3;
    color: var(--text);
    transition: color 0.2s;
  }

  .next-arrow {
    display: inline-block;
    color: var(--purple-400);
    transition: transform 0.2s;
  }

  .next-summary {
    margin-top: 8px;
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--text-muted);
  }

  .next-link a:hover .next-title {
    color: var(--purple-300);
  }

  .next-link a:hover .next-arrow {
    transform: translateX(4px);
  }

  /* Phones and tablets: sidebar blocks become panels above/below the article */
  @media (max-width: 860px) {
    .reading-layout.has-side {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 32px;
    }

    .reading-side {
      display: contents;
      max-height: none;
    }

    .reading-side :global(.side-block) {
      background: rgba(13, 10, 22, 0.72);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: 18px;
    }

    .reading-side :global(.side-block + .side-block) {
      margin-top: 0;
    }

    .reading-side :global(.side-first) {
      order: -1;
    }

    .next-link {
      flex-direction: column;
      margin-top: 56px;
    }

    .next-link a {
      text-align: left;
    }
  }

  /* Small phones: drop the section label so the date line fits on one row */
  @media (max-width: 420px) {
    .reading-meta > :first-child {
      display: none;
    }

    .reading-meta > :nth-child(2)::before {
      content: none;
    }
  }
</style>
