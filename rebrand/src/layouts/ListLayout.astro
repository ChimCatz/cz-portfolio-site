---
// Index page for a long-form collection: heading block, then a list
// (banner thumbnail beside date, linked title, one-line summary), newest first.
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import { entryHref, formatDate, getSorted, type ReadingCollection } from '../lib/reading';

interface Props {
  collection: ReadingCollection;
  /** Browser tab title and meta description */
  pageTitle: string;
  description: string;
  eyebrow: string;
  intro: string;
}

const { collection, pageTitle, description, eyebrow, intro } = Astro.props;
const entries = await getSorted(collection);
---

<BaseLayout title={pageTitle} description={description} dimBackground>
  <div class="container entries">
    <header>
      <p class="eyebrow">{eyebrow}</p>
      <h1><slot name="heading" /></h1>
      <p class="entries-intro">{intro}</p>
    </header>

    <ol class="entry-list">
      {entries.map((entry, i) => (
        <li class:list={{ 'has-thumb': entry.data.banner }}>
          {entry.data.banner && (
            <div class="entry-thumb">
              <Image
                src={entry.data.banner}
                alt=""
                widths={[320, 480, 720]}
                sizes="(max-width: 600px) calc(100vw - 32px), 280px"
                loading={i < 3 ? 'eager' : 'lazy'}
                style={`object-position: ${entry.data.thumbFocus} center`}
              />
            </div>
          )}
          <div class="entry-text">
            <time class="eyebrow" datetime={entry.data.date.toISOString().slice(0, 10)}>
              {formatDate(entry.data.date)}
            </time>
            <h2>
              <a href={entryHref(collection, entry)}>{entry.data.title}</a>
            </h2>
            <p>{entry.data.summary}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</BaseLayout>

<style>
  .entries {
    max-width: calc(880px + var(--gutter) * 2);
    padding-top: calc(var(--header-h) + clamp(32px, 6vh, 64px));
    padding-bottom: 96px;
  }

  h1 {
    margin-top: 14px;
    font-size: clamp(2.2rem, 5vw, 3.5rem);
  }

  .entries-intro {
    margin-top: 18px;
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    color: var(--text-muted);
  }

  .entry-list {
    list-style: none;
    margin: clamp(36px, 6vh, 56px) 0 0;
    padding: 0;
  }

  .entry-list li {
    position: relative;
    padding: 28px 0;
    border-top: 1px solid var(--line);
  }

  .entry-list li:last-child {
    border-bottom: 1px solid var(--line);
  }

  /* Thumbnail beside the text, exactly as tall as the text (date to summary):
     the image is taken out of the flow, so the text alone sets the row height. */
  .entry-list .has-thumb {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    column-gap: 28px;
  }

  .entry-thumb {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--bg-raised);
    transition: border-color 0.25s, box-shadow 0.25s;
  }

  .entry-thumb img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .entry-list li:hover .entry-thumb {
    border-color: var(--line-strong);
    box-shadow: 0 18px 44px -26px var(--glow);
  }

  .entry-list li:hover .entry-thumb img {
    transform: scale(1.04);
  }

  /* Cap height, not line height, lines up with the image's top edge */
  .entry-text time {
    display: block;
    line-height: 1.3;
  }

  .entry-list h2 {
    margin-top: 8px;
    font-size: clamp(1.25rem, 2.4vw, 1.6rem);
    font-weight: 600;
    line-height: 1.3;
  }

  /* The whole row is clickable through the title link */
  .entry-list a {
    text-decoration: none;
    transition: color 0.2s;
  }

  .entry-list a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .entry-list li:hover a {
    color: var(--purple-300);
  }

  .entry-list p {
    margin-top: 10px;
    color: var(--text-muted);
    line-height: 1.7;
  }

  /* Phones: the image goes on top, full width */
  @media (max-width: 600px) {
    .entry-list .has-thumb {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 16px;
    }

    .entry-thumb {
      aspect-ratio: 2 / 1;
    }
  }
</style>
