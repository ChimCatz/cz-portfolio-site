---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="CZ Catalan | Data Analyst Portfolio"
  description="CZ Catalan is a data analyst with an engineering background working across CRM data, reporting, and dashboards, using Python, SQL, and AI to automate the boring parts."
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero-inner">
      <h1 id="hero-title">
        <span>Clean.</span>
        <span>Analyze.</span>
        <span>Visualize.</span>
        <span class="gradient-text">Automate.</span>
      </h1>
      <p class="hero-intro">
        I'm <strong>CZ</strong>, a data analyst with an engineering background and a soft spot for
        messy data. I work across CRM data, reporting, and dashboards. Python, SQL, and AI help me
        automate the boring parts in minutes instead of hours.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  /* The whole hero fits in the first screen on every device:
     it is exactly one viewport tall, and the type scales with
     the viewport height as well as the width. */
  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    min-height: 100vh;
    min-height: 100svh; /* ignores the mobile browser address bar */
    /* Top padding clears the fixed header */
    padding-top: calc(var(--header-h) + clamp(16px, 4vh, 48px));
    padding-bottom: clamp(24px, 6vh, 64px);
  }

  /* Darkens the side where the text sits so it reads over the globe */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(
      90deg,
      rgba(7, 5, 12, 0.88) 0%,
      rgba(7, 5, 12, 0.55) 45%,
      rgba(7, 5, 12, 0) 75%
    );
  }

  .hero h1 {
    display: flex;
    flex-direction: column;
    font-size: clamp(2.5rem, min(8vw, 10.5vh), 5.75rem);
    line-height: 1;
  }

  .hero-intro {
    margin-top: clamp(20px, 4vh, 36px);
    max-width: 50ch;
    font-size: clamp(1rem, min(1.4vw, 2.4vh), 1.25rem);
    line-height: 1.65;
    color: var(--text-muted);
  }

  .hero-intro strong {
    color: var(--purple-300);
    font-weight: 600;
  }

  /* Intro: the four words rise in one by one, then a light sweeps across
     "Automate." once; the paragraph follows. Off for reduced motion. */
  @media (prefers-reduced-motion: no-preference) {
    .hero h1 span {
      animation: hero-in 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }

    .hero h1 span:nth-child(1) { animation-delay: 0.15s; }
    .hero h1 span:nth-child(2) { animation-delay: 0.3s; }
    .hero h1 span:nth-child(3) { animation-delay: 0.45s; }

    /* The shine is a second, white gradient layer clipped to the text,
       parked off the left edge and swept across to the right. */
    .hero h1 .gradient-text {
      background-image:
        linear-gradient(110deg, transparent 40%, rgba(255, 255, 255, 0.9) 50%, transparent 60%),
        var(--brand-gradient);
      background-size: 250% 100%, 100% 100%;
      background-position: 103% 0, 0 0;
      background-repeat: no-repeat;
      animation:
        hero-in 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) 0.6s both,
        hero-shine 1.4s ease-in-out 1.35s both;
    }

    .hero-intro {
      animation: hero-in 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) 0.85s both;
    }
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      translate: 0 0.35em;
      filter: blur(6px);
    }
    to {
      opacity: 1;
      translate: none;
      filter: none;
    }
  }

  @keyframes hero-shine {
    from {
      background-position: 103% 0, 0 0;
    }
    to {
      background-position: -3% 0, 0 0;
    }
  }

  /* Phones: the globe fills the top of the screen, so the text
     sits at the bottom over a darker fade. */
  @media (max-width: 760px) {
    .hero {
      align-items: flex-end;
    }

    .hero::before {
      background: linear-gradient(
        0deg,
        rgba(7, 5, 12, 0.94) 0%,
        rgba(7, 5, 12, 0.75) 50%,
        rgba(7, 5, 12, 0) 85%
      );
    }

    .hero-intro {
      font-size: clamp(0.95rem, 2.1vh, 1.05rem);
      line-height: 1.6;
    }
  }
</style>
