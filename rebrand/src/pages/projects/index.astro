---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { entryHref, getSorted } from '../../lib/reading';

const projects = await getSorted('projects');
const featured = projects.find((p) => p.data.featured);
const others = projects.filter((p) => p !== featured);

// Card titles use the part before the colon: "Search & Filter Engine: From ..." -> "Search & Filter Engine"
const shortTitle = (title: string) => title.split(':')[0];

// Smaller tools in the suite: one line each, no page of their own.
const automations = [
  {
    name: 'Email Validation Importer',
    text: 'Turns email validation results into one CRM update file. When an address appears twice, the most severe status wins.',
  },
  {
    name: 'Campaign Report Formatter',
    text: "Turns a raw CRM export into each campaign's report table. Formats are saved and edited in the tool, not in code.",
  },
  {
    name: 'Contact Request Builder',
    text: "Takes a teammate's free-text request, pulls out the email addresses, and builds one clean import, flagging contacts with risky history.",
  },
  {
    name: 'Email Campaign Consolidator',
    text: 'Combines email campaign reports into CRM-ready imports and a password-protected summary workbook.',
  },
];
---

<BaseLayout
  title="Projects | CZ Catalan"
  description="Tools CZ Catalan built to automate CRM data work: a Python desktop suite for searching, converting, reconciling, and reporting on lead data, and the Excel and VBA work that came before it."
  dimBackground
>
  <div class="container projects">
    <header class="projects-head">
      <p class="eyebrow">Projects</p>
      <h1>Tools I built to take the <span class="gradient-text">busywork</span> out of data.</h1>
      <p class="projects-intro">
        Most of these started as one tedious task at my day job and grew into a suite my team uses every
        day. Tool names here are generic, and no real company data is shown.
      </p>
    </header>

    {featured && (
      <a class="featured" href={entryHref('projects', featured)}>
        <div class="featured-image">
          <Image
            src={featured.data.thumb}
            alt=""
            widths={[640, 960, 1280]}
            sizes="(max-width: 860px) calc(100vw - 32px), 560px"
            loading="eager"
          />
        </div>
        <div class="featured-text">
          <p class="eyebrow">{featured.data.kicker}</p>
          <h2>{featured.data.title}</h2>
          <p class="featured-summary">{featured.data.summary}</p>
          <ul class="featured-results">
            {featured.data.results.map((r) => (
              <li><b>{r.value}</b> {r.label}</li>
            ))}
          </ul>
          <span class="cta">Read the case study <span aria-hidden="true">→</span></span>
        </div>
      </a>
    )}

    <section class="block" aria-labelledby="tools-heading">
      <h2 id="tools-heading" class="block-heading">Tools and projects</h2>
      <ul class="cards">
        {others.map((project) => {
          const headline = project.data.results[0];
          return (
            <li>
              <a class="card" href={entryHref('projects', project)}>
                <div class="card-image">
                  <Image
                    src={project.data.thumb}
                    alt=""
                    widths={[480, 720, 960]}
                    sizes="(max-width: 760px) calc(100vw - 32px), 520px"
                  />
                </div>
                <div class="card-text">
                  <p class="card-kicker">{project.data.kicker}</p>
                  <h3>{shortTitle(project.data.title)}</h3>
                  <p class="card-summary">{project.data.summary}</p>
                  {headline && (
                    <p class="card-headline"><b>{headline.value}</b> {headline.label}</p>
                  )}
                </div>
              </a>
            </li>
          );
        })}
      </ul>
    </section>

    <section class="block" aria-labelledby="automations-heading">
      <h2 id="automations-heading" class="block-heading">Small automations</h2>
      <p class="block-intro">
        Smaller tools in the same suite. Each one removes a single repetitive step, which adds up across a week.
      </p>
      <ul class="automations">
        {automations.map((item) => (
          <li>
            <h3>{item.name}</h3>
            <p>{item.text}</p>
          </li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .projects {
    padding-top: calc(var(--header-h) + clamp(32px, 6vh, 64px));
    padding-bottom: 96px;
  }

  .projects-head {
    max-width: 820px;
  }

  .projects-head h1 {
    margin-top: 14px;
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    text-wrap: balance;
  }

  .projects-intro {
    margin-top: 18px;
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    line-height: 1.7;
    color: var(--text-muted);
  }

  /* Shared card surface */
  .featured,
  .card,
  .automations li {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: rgba(13, 10, 22, 0.72);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .featured,
  .card {
    display: block;
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
  }

  .featured:hover,
  .card:hover {
    border-color: var(--line-strong);
    transform: translateY(-3px);
    box-shadow: 0 24px 60px -30px var(--glow);
  }

  /* Featured case study */
  .featured {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    margin-top: clamp(36px, 6vh, 56px);
  }

  .featured-image img,
  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .featured-image {
    border-right: 1px solid var(--line);
  }

  .featured-text {
    display: flex;
    flex-direction: column;
    padding: clamp(22px, 3vw, 36px);
  }

  .featured h2 {
    margin-top: 10px;
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    line-height: 1.15;
  }

  .featured-summary {
    margin-top: 12px;
    color: var(--text-muted);
    line-height: 1.65;
  }

  .featured-results {
    display: grid;
    gap: 6px;
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.9rem;
    color: var(--text-soft);
  }

  .featured-results b,
  .card-headline b {
    font-family: var(--font-display);
    background: var(--brand-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .cta {
    margin-top: auto;
    padding-top: 22px;
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--purple-300);
  }

  .cta span {
    display: inline-block;
    transition: transform 0.2s;
  }

  .featured:hover .cta span {
    transform: translateX(4px);
  }

  /* Section headings: same gradient rule + spaced caps as About Me */
  .block {
    margin-top: clamp(56px, 8vh, 80px);
  }

  .block-heading {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--purple-300);
  }

  .block-heading::before {
    content: '';
    width: 36px;
    height: 2px;
    border-radius: 2px;
    background: var(--brand-gradient);
    box-shadow: 0 0 10px var(--glow);
  }

  .block-intro {
    margin-top: 12px;
    max-width: 640px;
    color: var(--text-muted);
  }

  /* Project cards */
  .cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin: 22px 0 0;
    padding: 0;
    list-style: none;
  }

  .cards li {
    display: flex;
  }

  .card {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .card-image {
    aspect-ratio: 5 / 2;
    border-bottom: 1px solid var(--line);
  }

  .card-text {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 20px 22px 22px;
  }

  .card-kicker {
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--purple-400);
  }

  .card h3 {
    margin-top: 8px;
    font-size: 1.3rem;
    line-height: 1.25;
    transition: color 0.2s;
  }

  .card:hover h3 {
    color: var(--purple-300);
  }

  .card-summary {
    margin-top: 10px;
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--text-muted);
  }

  .card-headline {
    margin-top: auto;
    padding-top: 16px;
    font-size: 0.88rem;
    color: var(--text-soft);
  }

  .card-headline b {
    font-size: 1.15rem;
  }

  /* Small automations */
  .automations {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    margin: 22px 0 0;
    padding: 0;
    list-style: none;
  }

  .automations li {
    padding: 18px 20px;
  }

  .automations h3 {
    font-size: 1.05rem;
    line-height: 1.3;
  }

  .automations p {
    margin-top: 6px;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--text-muted);
  }

  @media (max-width: 860px) {
    .featured {
      grid-template-columns: minmax(0, 1fr);
    }

    .featured-image {
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }
  }

  @media (max-width: 760px) {
    .cards,
    .automations {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
