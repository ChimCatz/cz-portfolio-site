---
import { Image } from 'astro:assets';
import ProjectBadges from '../../components/projects/ProjectBadges.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { entryHref, getSorted } from '../../lib/reading';
import { shortTitle, shotClass, shotStyle, tagline, thumbAlt, type Project } from '../../lib/projects';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const all = await getSorted('projects');
// Side projects made for fun sit in their own section below the work.
const projects = all.filter((p) => p.data.category !== 'fun');
const fun = all.filter((p) => p.data.category === 'fun');

// One list, every project in the same kind of row. The filter buttons narrow
// it by these tags; a filter only appears when at least one project has its tag.
const FILTERS = [
  { tag: 'automation', label: 'Automation tools' },
  { tag: 'dashboard', label: 'Dashboards' },
  { tag: 'open-source', label: 'Open source' },
  { tag: 'ongoing', label: 'Ongoing' },
];
const tags = (p: Project) => [
  p.data.category,
  ...(p.data.repo ? ['open-source'] : []),
  ...(p.data.status === 'ongoing' ? ['ongoing'] : []),
];
const filters = FILTERS.map((filter) => ({
  ...filter,
  count: projects.filter((p) => tags(p).includes(filter.tag)).length,
})).filter((filter) => filter.count > 0);

/** Dashboard projects link straight to the live page as well as the case study. */
const liveHref = (p: Project) => (p.data.dashboards[0] ? `${base}/dashboards/${p.data.dashboards[0].src}` : undefined);

// Smaller tools in the suite: one line each, no page of their own.
const automations = [
  {
    name: 'Email Validation Importer',
    text: 'Turns email validation results into one CRM update file. When an address appears twice, the most severe status wins.',
  },
  {
    name: 'Campaign Report Formatter',
    text: "Turns a raw CRM export into each campaign's report table. Formats are saved and edited in the tool, not in code.",
  },
  {
    name: 'Contact Request Builder',
    text: "Takes a free-text request, pulls out the email addresses, and builds one clean import, flagging contacts with risky history.",
  },
  {
    name: 'Email Campaign Consolidator',
    text: 'Combines email campaign reports into CRM-ready imports and a password-protected summary workbook.',
  },
];
---

<BaseLayout
  title="Projects | CZ Catalan"
  description="Automation tools and dashboards by CZ Catalan: a Python desktop suite for CRM data work, live Zoho Analytics dashboards, a VoIP call tracking tool built on Google Apps Script, and open-source projects still in progress."
  dimBackground
>
  <div class="container projects">
    <header class="projects-head">
      <p class="eyebrow">Projects</p>
      <h1>Things I built to take the <span class="gradient-text">busywork</span> out of data.</h1>
      <p class="projects-intro">
        Automation tools and dashboards I designed and built. Most started as one tedious task and grew
        into something used every day, and two are open source and still in progress. The CRM tools go
        by generic names, and the dashboards show sample data with sample names. Side projects made
        for fun are at the bottom.
      </p>
    </header>

    <!-- Shown by the script below: without it the buttons would do nothing -->
    <div class="filters" role="group" aria-label="Filter projects" data-filters hidden>
      <button type="button" data-filter="all" aria-pressed="true">All <span>{projects.length}</span></button>
      {filters.map((filter) => (
        <button type="button" data-filter={filter.tag} aria-pressed="false">
          {filter.label} <span>{filter.count}</span>
        </button>
      ))}
    </div>

    <ol class="project-list">
      {projects.map((project, i) => {
        const href = entryHref('projects', project);
        const live = liveHref(project);
        const { thumb, results, flow, tools, repo, demo } = project.data;
        return (
          <li class:list={['project', { 'has-shot': thumb }]} data-tags={tags(project).join(' ')}>
            <div class="project-head">
              <p class="project-meta">
                <span class="project-num" aria-hidden="true"></span>
                <span>{project.data.kicker}</span>
              </p>
              <h2><a href={href}>{shortTitle(project)}</a></h2>
              {tagline(project) && <p class="project-tagline">{tagline(project)}</p>}
              <ProjectBadges project={project} />
            </div>

            <!-- A picture where the project has one, its headline numbers where it doesn't -->
            <div class="project-panel">
              {thumb && (
                <a class:list={shotClass(project)} style={shotStyle(project)} href={href} tabindex="-1" aria-hidden="true">
                  <Image
                    src={thumb}
                    alt={thumbAlt(project)}
                    widths={[360, 480, 720, 960]}
                    sizes="(max-width: 860px) calc(100vw - 32px), 460px"
                    loading={i < 2 ? 'eager' : 'lazy'}
                  />
                </a>
              )}
              {results.length > 0 && (
                <ul class="stats" aria-label="Results">
                  {(thumb ? results.slice(0, 2) : results).map((r) => (
                    <li>
                      <b data-count>{r.value}</b>
                      <span>{r.label}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>

            <div class="project-body">
              <p class="project-summary">{project.data.summary}</p>

              {flow.length > 0 ? (
                <p class="project-stack">
                  <span class="stack-label">Data flow</span>
                  {flow.map((step, n) => (
                    <span>{step}{n < flow.length - 1 && <i aria-hidden="true">→</i>}</span>
                  ))}
                </p>
              ) : (
                tools.length > 0 && (
                  <p class="project-stack">
                    <span class="stack-label">Built with</span>
                    {tools.map((tool, n) => (
                      <span>{tool}{n < tools.length - 1 && <i aria-hidden="true">·</i>}</span>
                    ))}
                  </p>
                )
              )}

              <p class="links">
                <a href={href}>Case study <span aria-hidden="true">↗</span></a>
                {live && (
                  <a class="link-quiet" href={live} target="_blank" rel="noopener">
                    Live dashboard <span aria-hidden="true">↗</span>
                  </a>
                )}
                {demo && (
                  <a class="link-quiet" href={`${href}#try-it`}>Try the demo <span aria-hidden="true">↗</span></a>
                )}
                {repo && (
                  <a class="link-quiet" href={repo} target="_blank" rel="noopener">
                    Source on GitHub <span aria-hidden="true">↗</span>
                  </a>
                )}
              </p>
            </div>
          </li>
        );
      })}
    </ol>

    <section class="block" aria-labelledby="automations-heading">
      <h2 id="automations-heading" class="block-heading">Small automations</h2>
      <p class="block-intro">
        Smaller tools in the Python suite. Each one removes a single repetitive step, which adds up across a week.
      </p>
      <ul class="automations">
        {automations.map((item) => (
          <li>
            <h3>{item.name}</h3>
            <p>{item.text}</p>
          </li>
        ))}
      </ul>
    </section>

    {fun.length > 0 && (
      <section class="block fun" aria-labelledby="fun-heading">
        <h2 id="fun-heading" class="block-heading">Just for fun</h2>
        <p class="block-intro">
          Side projects I make to play with data and learn. I plan them and write the prompts, and AI
          writes the code, so they show ideas and data work, not my programming.
        </p>
        <ul class="fun-list">
          {fun.map((project) => {
            const href = entryHref('projects', project);
            const { thumb, live, repo } = project.data;
            return (
              <li class:list={['fun-card', { 'has-shot': thumb }]}>
                {thumb && (
                  <a class:list={shotClass(project)} style={shotStyle(project)} href={href} tabindex="-1" aria-hidden="true">
                    <Image
                      src={thumb}
                      alt={thumbAlt(project)}
                      widths={[360, 480, 720]}
                      sizes="(max-width: 700px) calc(100vw - 32px), 400px"
                      loading="lazy"
                    />
                  </a>
                )}
                <div class="fun-text">
                  <p class="fun-kicker">{project.data.kicker}</p>
                  <h3><a href={href}>{shortTitle(project)}</a></h3>
                  {tagline(project) && <p class="project-tagline">{tagline(project)}</p>}
                  <ProjectBadges project={project} />
                  <p class="fun-summary">{project.data.summary}</p>
                  <p class="links">
                    {live && (
                      <a href={live.url} target="_blank" rel="noopener">
                        Play it <span aria-hidden="true">↗</span>
                      </a>
                    )}
                    <a class={live ? 'link-quiet' : undefined} href={href}>How it was made <span aria-hidden="true">↗</span></a>
                    {repo && (
                      <a class="link-quiet" href={repo} target="_blank" rel="noopener">
                        Source on GitHub <span aria-hidden="true">↗</span>
                      </a>
                    )}
                  </p>
                </div>
              </li>
            );
          })}
        </ul>
      </section>
    )}

    <p class="closing">
      Want the details behind any of these?
      <a href={`${base}/contact`}>Get in touch <span aria-hidden="true">→</span></a>
    </p>
  </div>
</BaseLayout>

<script>
  // Filter buttons: show the rows that carry the chosen tag. The whole list is
  // in the HTML, so the page reads the same without this script.
  const bar = document.querySelector<HTMLElement>('[data-filters]');
  const rows = Array.from(document.querySelectorAll<HTMLElement>('.project[data-tags]'));
  if (bar) {
    bar.hidden = false;
    const buttons = Array.from(bar.querySelectorAll<HTMLButtonElement>('button[data-filter]'));
    bar.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('button[data-filter]');
      if (!button) return;
      const filter = button.dataset.filter!;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
      rows.forEach((row) => {
        row.hidden = filter !== 'all' && !row.dataset.tags!.split(' ').includes(filter);
      });
    });
  }
</script>

<style>
  .projects {
    padding-top: calc(var(--header-h) + clamp(32px, 6vh, 64px));
    padding-bottom: 96px;
  }

  .projects-head {
    max-width: 820px;
  }

  .projects-head h1 {
    margin-top: 14px;
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    text-wrap: balance;
  }

  .projects-intro {
    margin-top: 18px;
    max-width: 62ch;
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    line-height: 1.7;
    color: var(--text-muted);
  }

  /* The image frame (.shot) is in global.css: the homepage uses the same one. */

  /* ---------- Filter buttons ---------- */
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: clamp(32px, 5vh, 48px);
  }

  .filters[hidden] {
    display: none;
  }

  .filters button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 14px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: rgba(13, 10, 22, 0.6);
    font-family: var(--font-display);
    font-size: 0.86rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--text-muted);
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s, background 0.2s;
  }

  .filters button span {
    font-size: 0.76rem;
    font-weight: 500;
    color: var(--text-faint);
    transition: color 0.2s;
  }

  .filters button:hover {
    border-color: var(--purple-400);
    color: var(--text);
  }

  .filters button[aria-pressed='true'] {
    border-color: var(--purple-500);
    background: var(--purple-500);
    color: #fff;
  }

  .filters button[aria-pressed='true'] span {
    color: rgba(255, 255, 255, 0.8);
  }

  /* ---------- The list: every project is one row, text beside a panel ---------- */
  .project-list {
    margin: clamp(20px, 3vh, 28px) 0 0;
    padding: 0;
    list-style: none;
    counter-reset: project;
  }

  /* Hidden rows don't count, so the numbers stay 01, 02, 03 under any filter */
  .project {
    counter-increment: project;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    grid-template-rows: auto 1fr;
    grid-template-areas:
      'head panel'
      'body panel';
    column-gap: clamp(32px, 5vw, 56px);
    padding: clamp(36px, 6vh, 52px) 0;
    border-top: 1px solid var(--line);
  }

  .project[hidden] {
    display: none;
  }

  .project-head {
    grid-area: head;
  }

  .project-panel {
    grid-area: panel;
  }

  .project-body {
    grid-area: body;
  }

  .project-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 12px;
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--purple-400);
  }

  .project-num {
    color: var(--text-faint);
  }

  .project-num::before {
    content: counter(project, decimal-leading-zero);
  }

  .project-num::after {
    content: '';
    display: inline-block;
    width: 28px;
    height: 1px;
    margin-left: 12px;
    vertical-align: middle;
    background: var(--line-strong);
  }

  .project h2 {
    margin-top: 12px;
    font-size: clamp(1.5rem, 2.6vw, 1.95rem);
    line-height: 1.15;
    text-wrap: balance;
  }

  .project h2 a {
    text-decoration: none;
    transition: color 0.2s;
  }

  .project h2 a:hover {
    color: var(--purple-300);
  }

  .project-tagline {
    margin-top: 8px;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.4;
    color: var(--text-muted);
  }

  .project-head :global(.badges) {
    margin-top: 16px;
  }

  .project-summary {
    margin-top: 18px;
    font-size: 0.98rem;
    line-height: 1.7;
    color: var(--text-soft);
  }

  /* Tools or data flow: one quiet line, so it doesn't compete with the badges */
  .project-stack {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 8px;
    margin-top: 14px;
    font-family: var(--font-display);
    font-size: 0.84rem;
    font-weight: 500;
    line-height: 1.6;
    color: var(--text-muted);
  }

  .stack-label {
    margin-right: 4px;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  /* The separator travels with the item before it, so a wrapped line never starts with one */
  .project-stack i {
    margin-left: 8px;
    font-style: normal;
    color: var(--purple-400);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin-top: 18px;
  }

  .links a,
  .closing a {
    font-family: var(--font-display);
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--purple-300);
    transition: color 0.2s;
  }

  .links a:hover,
  .closing a:hover {
    color: var(--text);
  }

  .links .link-quiet {
    color: var(--text-muted);
  }

  /* ---------- The panel: a framed image over two numbers, or three numbers on their own ---------- */
  .project:hover .shot,
  .project:hover .stats {
    border-color: var(--purple-400);
  }

  .project:hover .shot {
    box-shadow: 0 24px 60px -30px var(--glow);
    transform: translateY(-3px);
  }

  .stats {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .stats b {
    font-family: var(--font-display);
    line-height: 1.15;
    white-space: nowrap;
    background: var(--brand-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .stats span {
    line-height: 1.45;
    color: var(--text-muted);
  }

  /* Without an image: the numbers are the panel */
  .project:not(.has-shot) .stats {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: rgba(13, 10, 22, 0.6);
    transition: border-color 0.25s;
  }

  .project:not(.has-shot) .stats::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    background: var(--brand-gradient);
  }

  .project:not(.has-shot) .stats li {
    display: grid;
    grid-template-columns: 8.6rem minmax(0, 1fr);
    align-items: center;
    column-gap: 16px;
    padding: 20px 22px 20px 25px;
  }

  .project:not(.has-shot) .stats li + li {
    border-top: 1px solid var(--line);
  }

  .project:not(.has-shot) .stats b {
    font-size: 1.7rem;
  }

  .project:not(.has-shot) .stats span {
    font-size: 0.88rem;
  }

  /* Under an image: two numbers side by side */
  .has-shot .stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px 24px;
    margin-top: 18px;
  }

  .has-shot .stats li {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .has-shot .stats b {
    font-size: 1.35rem;
  }

  .has-shot .stats span {
    font-size: 0.82rem;
  }

  /* ---------- Sections: gradient rule + spaced caps, as on About Me ---------- */
  .block {
    margin-top: 0;
    padding-top: clamp(32px, 5vh, 48px);
    border-top: 1px solid var(--line);
  }

  .block-heading {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--purple-300);
  }

  .block-heading::before {
    content: '';
    flex: none;
    width: 36px;
    height: 2px;
    border-radius: 2px;
    background: var(--brand-gradient);
    box-shadow: 0 0 10px var(--glow);
  }

  .block-intro {
    margin-top: 12px;
    max-width: 640px;
    color: var(--text-muted);
  }

  /* ---------- Small automations: a plain two-column list ---------- */
  .automations {
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }

  .automations li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2.4fr);
    align-items: baseline;
    column-gap: 32px;
    padding: 16px 0;
    border-top: 1px solid var(--line);
  }

  .automations li:last-child {
    border-bottom: 1px solid var(--line);
  }

  .automations h3 {
    font-size: 1.02rem;
    line-height: 1.35;
  }

  .automations p {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--text-muted);
  }

  /* ---------- Just for fun: smaller cards, picture beside the text ---------- */
  .fun {
    margin-top: clamp(56px, 9vh, 88px);
  }

  .fun-list {
    display: grid;
    gap: 20px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }

  .fun-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px clamp(24px, 4vw, 40px);
    padding: clamp(18px, 3vw, 24px);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: rgba(13, 10, 22, 0.6);
    transition: border-color 0.25s;
  }

  .fun-card.has-shot {
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr);
    align-items: center;
  }

  .fun-card:hover {
    border-color: var(--purple-400);
  }

  .fun-kicker {
    font-family: var(--font-display);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--purple-400);
  }

  .fun-card h3 {
    margin-top: 8px;
    font-size: clamp(1.3rem, 2.2vw, 1.6rem);
    line-height: 1.2;
  }

  .fun-card h3 a {
    text-decoration: none;
    transition: color 0.2s;
  }

  .fun-card h3 a:hover {
    color: var(--purple-300);
  }

  .fun-text :global(.badges) {
    margin-top: 14px;
  }

  .fun-summary {
    margin-top: 14px;
    font-size: 0.94rem;
    line-height: 1.65;
    color: var(--text-soft);
  }

  .fun-card .links {
    margin-top: 14px;
  }

  .closing {
    margin-top: clamp(56px, 9vh, 88px);
    font-size: 1.05rem;
    color: var(--text-muted);
  }

  .closing a {
    margin-left: 6px;
    font-size: 1.05rem;
    white-space: nowrap;
  }

  /* Tablets and phones: one column, the panel between the title and the summary */
  @media (max-width: 860px) {
    .project {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto;
      grid-template-areas:
        'head'
        'panel'
        'body';
    }

    .project-panel {
      margin-top: 22px;
    }

    .project-summary {
      margin-top: 20px;
    }
  }

  @media (max-width: 700px) {
    .fun-card.has-shot {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 600px) {
    .automations li {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 4px;
    }
  }

  @media (max-width: 420px) {
    .project:not(.has-shot) .stats li {
      grid-template-columns: 6.6rem minmax(0, 1fr);
      column-gap: 12px;
      padding: 16px 16px 16px 19px;
    }

    .project:not(.has-shot) .stats b {
      font-size: 1.35rem;
    }
  }
</style>
