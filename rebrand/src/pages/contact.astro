---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import profileImg from '../assets/about/cz-profile.jpg';
import { EMAIL, ICONS, SOCIALS as socials } from '../lib/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  title="Get in Touch | CZ Catalan"
  description="Contact CZ Catalan, a data analyst in Cagayan de Oro City, Philippines, by email, LinkedIn, Facebook, or GitHub."
  dimBackground
>
  <div class="container contact">
    <!-- Left: who you're writing to -->
    <aside class="contact-card" aria-label="Profile">
      <div class="photo">
        <Image
          src={profileImg}
          alt="Portrait of CZ Catalan"
          widths={[240, 320, 480, 640]}
          sizes="(max-width: 860px) 112px, 280px"
          loading="eager"
        />
      </div>

      <div class="card-text">
        <p class="card-name">Chim Zoe Catalan</p>
        <p class="card-role">Data Analyst</p>

        <dl class="facts">
          <div>
            <dt>Based In</dt>
            <dd>Cagayan de Oro City, Philippines</dd>
          </div>
          <div>
            <dt>Local Time</dt>
            <dd><span data-local-time></span>UTC+8</dd>
          </div>
        </dl>
      </div>
    </aside>

    <!-- Right: how to reach me -->
    <section class="contact-main" aria-labelledby="contact-title">
      <p class="eyebrow">Get in Touch</p>
      <h1 id="contact-title">Let's talk <span class="gradient-text">data.</span></h1>
      <p class="contact-intro">
        Have a question about one of my projects, an idea for a dashboard, or data that needs untangling?
        Send me a message. Email is the fastest way to reach me, and I'm on the networks below too.
      </p>

      <div class="channel channel-email">
        <a class="channel-link" href={`mailto:${EMAIL}`}>
          <span class="channel-icon">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d={ICONS.gmail}></path></svg>
          </span>
          <span class="channel-text">
            <span class="channel-label">Email</span>
            <span class="channel-handle">{EMAIL.split('@')[0]}@<wbr />{EMAIL.split('@')[1]}</span>
          </span>
        </a>
        <button class="copy" type="button" data-copy={EMAIL} hidden>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <rect x="9" y="9" width="11" height="11" rx="2"></rect>
            <path d="M5 15V6a2 2 0 0 1 2-2h9"></path>
          </svg>
          <span data-copy-label>Copy</span>
        </button>
      </div>

      <ul class="socials">
        {socials.map((s) => (
          <li>
            <a class="channel channel-link" href={s.href} target="_blank" rel="noopener">
              <span class="channel-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d={s.icon}></path></svg>
              </span>
              <span class="channel-text">
                <span class="channel-label">{s.label} <span class="channel-arrow" aria-hidden="true">↗</span></span>
                <span class="channel-handle">{s.handle}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>

      <p class="contact-more">
        Looking for my background first?
        <a href={`${base}/resume`}>See my resume <span aria-hidden="true">→</span></a>
      </p>
    </section>
  </div>
</BaseLayout>

<script>
  // Live local time, so visitors know whether it's a reasonable hour to expect a reply.
  const clock = document.querySelector<HTMLElement>('[data-local-time]');
  if (clock) {
    const format = new Intl.DateTimeFormat('en-US', { hour: 'numeric', minute: '2-digit', timeZone: 'Asia/Manila' });
    const update = () => {
      clock.textContent = `${format.format(new Date())} · `;
    };
    update();
    setInterval(update, 15_000);
  }

  // Copy button: only shown where the clipboard is available.
  const copy = document.querySelector<HTMLButtonElement>('[data-copy]');
  const label = copy?.querySelector<HTMLElement>('[data-copy-label]');
  if (copy && label && navigator.clipboard) {
    copy.hidden = false;
    let reset: number | undefined;
    copy.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(copy.dataset.copy ?? '');
        label.textContent = 'Copied';
      } catch {
        label.textContent = 'Press Ctrl+C';
      }
      window.clearTimeout(reset);
      reset = window.setTimeout(() => {
        label.textContent = 'Copy';
      }, 2000);
    });
  }
</script>

<style>
  /* Same 25% / 75% split as About Me */
  .contact {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
    align-items: start;
    column-gap: clamp(32px, 5vw, 72px);
    padding-top: calc(var(--header-h) + clamp(32px, 6vh, 64px));
    padding-bottom: 96px;
  }

  /* Profile card */
  .contact-card {
    padding: 16px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: rgba(13, 10, 22, 0.72);
  }

  .photo {
    overflow: hidden;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    box-shadow: 0 18px 48px -20px var(--glow);
  }

  .photo img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .card-name {
    margin-top: 18px;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.25;
  }

  .card-role {
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .facts {
    margin: 16px 0 0;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }

  .facts div + div {
    margin-top: 12px;
  }

  .facts dt {
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--purple-400);
  }

  .facts dd {
    margin: 2px 0 0;
    font-size: 0.92rem;
    line-height: 1.5;
    font-variant-numeric: tabular-nums;
  }

  /* Heading and intro */
  .contact-main {
    max-width: 760px;
    padding-top: clamp(0px, 1vw, 8px);
  }

  .contact-main h1 {
    margin-top: 14px;
    font-size: clamp(2.4rem, 5.5vw, 4rem);
  }

  .contact-intro {
    margin-top: 20px;
    max-width: 58ch;
    font-size: clamp(1.02rem, 1.5vw, 1.15rem);
    line-height: 1.75;
    color: var(--text-soft);
  }

  /* Contact channels: logo, name, handle */
  .channel {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: rgba(13, 10, 22, 0.72);
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
  }

  .channel:hover,
  .channel:focus-within {
    border-color: var(--line-strong);
    box-shadow: 0 20px 50px -30px var(--glow);
  }

  a.channel:hover {
    transform: translateY(-2px);
  }

  .channel-link {
    display: flex;
    align-items: center;
    gap: 14px;
    min-width: 0;
    padding: 14px 16px;
    text-decoration: none;
  }

  .channel-icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line-strong);
    border-radius: 12px;
    background: linear-gradient(145deg, rgba(124, 58, 237, 0.34), rgba(46, 26, 92, 0.5));
    color: var(--purple-300);
    transition: color 0.2s, background 0.2s;
  }

  .channel-icon svg {
    width: 21px;
    height: 21px;
    fill: currentColor;
  }

  .channel:hover .channel-icon {
    background: var(--purple-500);
    color: #fff;
  }

  .channel-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .channel-label {
    font-family: var(--font-display);
    font-weight: 600;
    line-height: 1.3;
  }

  .channel-handle {
    font-size: 0.86rem;
    line-height: 1.45;
    color: var(--text-muted);
    overflow-wrap: break-word;
  }

  .channel-arrow {
    display: inline-block;
    color: var(--purple-400);
    transition: transform 0.2s;
  }

  .channel:hover .channel-arrow {
    transform: translate(2px, -2px);
  }

  /* Email is the main channel: full width, larger, with a copy button */
  .channel-email {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: clamp(28px, 4vh, 40px);
    padding-right: 16px;
    border-color: var(--line-strong);
  }

  .channel-email .channel-link {
    flex: 1;
    padding-block: 18px;
  }

  .channel-email .channel-handle {
    font-size: clamp(0.92rem, 1.5vw, 1.1rem);
    color: var(--text);
  }

  .copy {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 8px;
    padding: 0.6em 1.1em;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: none;
    font-family: var(--font-display);
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text);
    cursor: pointer;
    transition: border-color 0.2s, background 0.2s;
  }

  .copy[hidden] {
    display: none;
  }

  .copy:hover {
    border-color: var(--purple-400);
    background: rgba(124, 58, 237, 0.14);
  }

  .copy svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .socials {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
  }

  .contact-more {
    margin-top: clamp(24px, 4vh, 36px);
    color: var(--text-muted);
  }

  .contact-more a {
    margin-left: 4px;
    font-family: var(--font-display);
    font-weight: 600;
    white-space: nowrap;
    text-decoration: none;
    color: var(--purple-300);
    transition: color 0.2s;
  }

  .contact-more a:hover {
    color: var(--text);
  }

  /* Narrow desktops: the three networks stack so handles don't get squeezed */
  @media (max-width: 1100px) {
    .socials {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Phones and tablets: a compact profile row on top, then the channels */
  @media (max-width: 860px) {
    .contact {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 32px;
    }

    .contact-card {
      display: grid;
      grid-template-columns: 112px minmax(0, 1fr);
      align-items: center;
      gap: 16px;
    }

    .card-name {
      margin-top: 0;
    }

    .facts {
      margin-top: 10px;
      padding-top: 10px;
    }

    .facts div + div {
      margin-top: 8px;
    }

    .facts dd {
      font-size: 0.85rem;
    }
  }

  @media (max-width: 480px) {
    .channel-email {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding-right: 0;
    }

    .copy {
      justify-content: center;
      margin: 0 16px 16px;
    }
  }
</style>
