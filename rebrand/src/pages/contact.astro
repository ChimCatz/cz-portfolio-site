---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import profileImg from '../assets/about/cz-profile.jpg';
import { CONTACT_API, EMAIL, ICONS, SOCIALS as socials, TERMS_LINK } from '../lib/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  title="Get in Touch | CZ Catalan"
  description="Contact CZ Catalan, a data analyst in Cagayan de Oro City, Philippines, by email, LinkedIn, Facebook, or GitHub."
  dimBackground
>
  <div class="container contact">
    <!-- Left: who you're writing to -->
    <aside class="contact-card" aria-label="Profile">
      <div class="photo">
        <Image
          src={profileImg}
          alt="Portrait of CZ Catalan"
          widths={[240, 320, 480, 640]}
          sizes="(max-width: 860px) 112px, 280px"
          loading="eager"
        />
      </div>

      <div class="card-text">
        <p class="card-name">Chim Zoe Catalan</p>
        <p class="card-role">Data Analyst</p>

        <dl class="facts">
          <div>
            <dt>Based In</dt>
            <dd>Cagayan de Oro City, Philippines</dd>
          </div>
          <div>
            <dt>Local Time</dt>
            <dd><span data-local-time></span>UTC+8</dd>
          </div>
        </dl>
      </div>
    </aside>

    <!-- Right: how to reach me -->
    <section class="contact-main" aria-labelledby="contact-title">
      <p class="eyebrow">Get in Touch</p>
      <h1 id="contact-title">Let's talk <span class="gradient-text">data.</span></h1>
      <p class="contact-intro">
        Have a question about one of my projects, an idea for a dashboard, or data that needs untangling?
        Send me a message here, or reach me by email or on the networks below.
      </p>

      <!-- The form posts to a Cloudflare Worker (worker/ in the repo). Cap, the
           human check, loads only once the visitor starts the form. -->
      <form class="contact-form" data-contact-form data-api={CONTACT_API} data-vendor={`${base}/vendor/cap/`} novalidate>
        <div class="form-row">
          <div class="field">
            <label for="cf-name">Full Name</label>
            <input id="cf-name" name="name" type="text" autocomplete="name" maxlength="100" required aria-describedby="cf-name-error" />
            <p class="field-error" id="cf-name-error"></p>
          </div>
          <div class="field">
            <label for="cf-email">Email</label>
            <input id="cf-email" name="email" type="email" autocomplete="email" maxlength="254" required aria-describedby="cf-email-error" />
            <p class="field-error" id="cf-email-error"></p>
          </div>
        </div>
        <div class="field">
          <label for="cf-message">Message</label>
          <textarea id="cf-message" name="message" rows="6" maxlength="5000" required aria-describedby="cf-message-error"></textarea>
          <p class="field-error" id="cf-message-error"></p>
        </div>

        <!-- Left empty by people (it's off screen); bots fill it in -->
        <div class="hp" aria-hidden="true">
          <label for="cf-website">Website</label>
          <input id="cf-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div class="form-foot">
          <div class="cap-slot">
            <cap-widget data-cap-api-endpoint={`${CONTACT_API}/cap/`} data-cap-i18n-initial-state="Verify you're human">
              <span class="cap-placeholder" aria-hidden="true"><span class="cap-box"></span>Verify you're human</span>
            </cap-widget>
          </div>
          <button class="btn btn-primary send" type="submit" data-send>Send message</button>
        </div>
        <p class="form-status" role="status" aria-live="polite" data-status></p>
        <p class="form-note">
          Your message goes to my inbox and isn't stored on this site.
          <a href={`${TERMS_LINK.href}#privacy`}>How the form handles data</a>
        </p>
      </form>

      <div class="form-sent" data-sent tabindex="-1" hidden>
        <p class="sent-title">Thanks, your message is on its way.</p>
        <p>I'll reply to the email address you gave.</p>
      </div>

      <noscript>
        <style is:inline>[data-contact-form] { display: none !important; }</style>
        <p class="form-sent">The contact form needs JavaScript. You can email me directly below.</p>
      </noscript>

      <h2 class="direct-title">Or reach me directly</h2>

      <div class="channel channel-email">
        <a class="channel-link" href={`mailto:${EMAIL}`}>
          <span class="channel-icon">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d={ICONS.gmail}></path></svg>
          </span>
          <span class="channel-text">
            <span class="channel-label">Email</span>
            <span class="channel-handle">{EMAIL.split('@')[0]}@<wbr />{EMAIL.split('@')[1]}</span>
          </span>
        </a>
        <button class="copy" type="button" data-copy={EMAIL} hidden>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <rect x="9" y="9" width="11" height="11" rx="2"></rect>
            <path d="M5 15V6a2 2 0 0 1 2-2h9"></path>
          </svg>
          <span data-copy-label>Copy</span>
        </button>
      </div>

      <ul class="socials">
        {socials.map((s) => (
          <li>
            <a class="channel channel-link" href={s.href} target="_blank" rel="noopener">
              <span class="channel-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d={s.icon}></path></svg>
              </span>
              <span class="channel-text">
                <span class="channel-label">{s.label} <span class="channel-arrow" aria-hidden="true">↗</span></span>
                <span class="channel-handle">{s.handle}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>

      <p class="contact-more">
        Looking for my background first?
        <a href={`${base}/resume`}>See my resume <span aria-hidden="true">→</span></a>
      </p>
    </section>
  </div>
</BaseLayout>

<script>
  // Live local time, so visitors know whether it's a reasonable hour to expect a reply.
  const clock = document.querySelector<HTMLElement>('[data-local-time]');
  if (clock) {
    const format = new Intl.DateTimeFormat('en-US', { hour: 'numeric', minute: '2-digit', timeZone: 'Asia/Manila' });
    const update = () => {
      clock.textContent = `${format.format(new Date())} · `;
    };
    update();
    setInterval(update, 15_000);
  }

  // Copy button: only shown where the clipboard is available.
  const copy = document.querySelector<HTMLButtonElement>('[data-copy]');
  const label = copy?.querySelector<HTMLElement>('[data-copy-label]');
  if (copy && label && navigator.clipboard) {
    copy.hidden = false;
    let reset: number | undefined;
    copy.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(copy.dataset.copy ?? '');
        label.textContent = 'Copied';
      } catch {
        label.textContent = 'Press Ctrl+C';
      }
      window.clearTimeout(reset);
      reset = window.setTimeout(() => {
        label.textContent = 'Copy';
      }, 2000);
    });
  }

  // ---------- Contact form ----------

  type CapWidget = HTMLElement & { token: string | null; solve(): Promise<unknown>; reset(): void };
  type CapWindow = Window & {
    CAP_CUSTOM_WASM_URL?: string;
    CAP_CUSTOM_FETCH?: typeof fetch;
    CAP_DISABLE_WIDGET_REF?: boolean;
  };

  // Same rule as the Worker: one @, no spaces, a dot in the domain.
  const EMAIL_PATTERN = /^[^\s@<>()[\]\\,;:"]+@[^\s@<>()[\]\\,;:"]+\.[^\s@<>()[\]\\,;:"]{2,}$/;

  const ERRORS: Record<string, string> = {
    name: 'Please enter your name.',
    email: 'Please enter a valid email address.',
    message: 'Please write a message.',
    verification: "The human check didn't go through. Please press Send again.",
    rate_limited: 'Too many messages in a short time. Please wait a minute and try again.',
    failed: "Your message couldn't be sent. Please try again, or email me directly below.",
  };

  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  if (form) setUpForm(form);

  function setUpForm(form: HTMLFormElement) {
    const api = form.dataset.api!;
    const vendor = form.dataset.vendor!;
    const widget = form.querySelector('cap-widget') as CapWidget;
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const send = form.querySelector<HTMLButtonElement>('[data-send]')!;
    const sent = document.querySelector<HTMLElement>('[data-sent]')!;
    const fields = {
      name: form.elements.namedItem('name') as HTMLInputElement,
      email: form.elements.namedItem('email') as HTMLInputElement,
      message: form.elements.namedItem('message') as HTMLTextAreaElement,
    };
    const honeypot = form.elements.namedItem('website') as HTMLInputElement;

    // The proof-of-work keeps the processor busy, so the globe rests while it
    // runs: from the challenge request until the token comes back (or fails).
    let busy = false;
    let busyTimer: number | undefined;
    const setBusy = (on: boolean) => {
      window.clearTimeout(busyTimer);
      if (on) busyTimer = window.setTimeout(() => setBusy(false), 60_000);
      if (on === busy) return;
      busy = on;
      document.dispatchEvent(new CustomEvent(on ? 'globe:pause' : 'globe:resume', { detail: 'contact-form' }));
    };
    const trackedFetch: typeof fetch = (input, init) => {
      const url = String(input);
      const request = fetch(input, init);
      if (url.endsWith('/challenge')) {
        setBusy(true);
        request.then((r) => !r.ok && setBusy(false), () => setBusy(false));
      } else if (url.endsWith('/redeem')) {
        request.then(
          () => setBusy(false),
          () => setBusy(false),
        );
      }
      return request;
    };
    widget.addEventListener('error', () => setBusy(false));

    // Cap loads on the first focus, tap or keystroke in the form, not with the page.
    let capReady: Promise<void> | null = null;
    const loadCap = () =>
      (capReady ??= new Promise<void>((resolve, reject) => {
        const w = window as CapWindow;
        w.CAP_CUSTOM_WASM_URL = `${vendor}cap_wasm_bg.wasm`;
        w.CAP_CUSTOM_FETCH = trackedFetch;
        w.CAP_DISABLE_WIDGET_REF = true;
        const script = document.createElement('script');
        script.src = `${vendor}cap.min.js`;
        script.onload = () => customElements.whenDefined('cap-widget').then(() => resolve());
        script.onerror = () => {
          capReady = null;
          script.remove();
          reject(new Error('failed'));
        };
        document.head.append(script);
      }));
    for (const type of ['focusin', 'pointerdown', 'input']) {
      form.addEventListener(type, () => loadCap().catch(() => {}), { once: true, passive: true });
    }

    // A token from an earlier solve (the widget solves quietly in the background
    // once it's loaded), or a fresh solve now.
    const getToken = () =>
      new Promise<string>((resolve, reject) => {
        if (widget.token) return resolve(widget.token);
        const done = () => {
          widget.removeEventListener('solve', onSolve);
          widget.removeEventListener('error', onError);
        };
        const onSolve = (e: Event) => {
          done();
          resolve((e as CustomEvent<{ token: string }>).detail.token);
        };
        const onError = () => {
          done();
          reject(new Error('verification'));
        };
        widget.addEventListener('solve', onSolve);
        widget.addEventListener('error', onError);
        widget.solve().catch(() => {});
      });

    const showError = (key: keyof typeof fields, message: string) => {
      const input = fields[key];
      input.setAttribute('aria-invalid', 'true');
      document.getElementById(`${input.id}-error`)!.textContent = message;
    };
    const clearError = (key: keyof typeof fields) => {
      fields[key].removeAttribute('aria-invalid');
      document.getElementById(`${fields[key].id}-error`)!.textContent = '';
    };
    for (const key of Object.keys(fields) as (keyof typeof fields)[]) {
      fields[key].addEventListener('input', () => clearError(key));
    }

    const setStatus = (text: string, isError = false) => {
      status.textContent = text;
      status.classList.toggle('is-error', isError);
    };

    let sending = false;
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (sending) return;

      const values = {
        name: fields.name.value.trim(),
        email: fields.email.value.trim(),
        message: fields.message.value.trim(),
      };
      const invalid = (Object.keys(fields) as (keyof typeof fields)[]).filter((key) => {
        const ok = key === 'email' ? EMAIL_PATTERN.test(values.email) : values[key].length > 0;
        if (ok) clearError(key);
        else showError(key, ERRORS[key]);
        return !ok;
      });
      if (invalid.length) {
        setStatus('Please check the highlighted fields.', true);
        fields[invalid[0]].focus();
        return;
      }

      sending = true;
      send.disabled = true;
      send.textContent = 'Sending...';
      form.setAttribute('aria-busy', 'true');
      setStatus('Sending your message...');

      try {
        await loadCap();
        const capToken = await getToken();
        const response = await fetch(`${api}/send`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ...values, website: honeypot.value, capToken }),
        });
        const result = await response.json().catch(() => ({}));
        if (!result.ok) throw new Error(result.error ?? 'failed');

        form.hidden = true;
        sent.hidden = false;
        sent.focus();
      } catch (error) {
        // Every token is single use, so the next try solves a fresh one.
        if (customElements.get('cap-widget')) widget.reset();
        const code = error instanceof Error ? error.message : 'failed';
        if (code in fields) showError(code as keyof typeof fields, ERRORS[code]);
        setStatus(ERRORS[code] ?? ERRORS.failed, true);
      } finally {
        sending = false;
        send.disabled = false;
        send.textContent = 'Send message';
        form.removeAttribute('aria-busy');
      }
    });
  }
</script>

<style>
  /* Same 25% / 75% split as About Me */
  .contact {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
    align-items: start;
    column-gap: clamp(32px, 5vw, 72px);
    padding-top: calc(var(--header-h) + clamp(32px, 6vh, 64px));
    padding-bottom: 96px;
  }

  /* Profile card */
  .contact-card {
    padding: 16px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: rgba(13, 10, 22, 0.72);
  }

  .photo {
    overflow: hidden;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    box-shadow: 0 18px 48px -20px var(--glow);
  }

  .photo img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .card-name {
    margin-top: 18px;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.25;
  }

  .card-role {
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .facts {
    margin: 16px 0 0;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }

  .facts div + div {
    margin-top: 12px;
  }

  .facts dt {
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--purple-400);
  }

  .facts dd {
    margin: 2px 0 0;
    font-size: 0.92rem;
    line-height: 1.5;
    font-variant-numeric: tabular-nums;
  }

  /* Heading and intro */
  .contact-main {
    max-width: 760px;
    padding-top: clamp(0px, 1vw, 8px);
  }

  .contact-main h1 {
    margin-top: 14px;
    font-size: clamp(2.4rem, 5.5vw, 4rem);
  }

  .contact-intro {
    margin-top: 20px;
    max-width: 58ch;
    font-size: clamp(1.02rem, 1.5vw, 1.15rem);
    line-height: 1.75;
    color: var(--text-soft);
  }

  /* Contact form: a solid panel, no blur (the page behind is already dimmed) */
  .contact-form,
  .form-sent {
    position: relative;
    margin-top: clamp(24px, 3.5vh, 36px);
    padding: clamp(18px, 2.5vw, 28px);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: rgba(13, 10, 22, 0.72);
  }

  .contact-form {
    display: grid;
    gap: 16px;
  }

  .form-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .field label {
    display: block;
    margin-bottom: 6px;
    font-family: var(--font-display);
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text);
  }

  .field input,
  .field textarea {
    display: block;
    width: 100%;
    padding: 11px 14px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    background: rgba(7, 5, 12, 0.7);
    font: inherit;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--text);
    transition: border-color 0.2s;
  }

  .field textarea {
    min-height: 9.5em;
    resize: vertical;
  }

  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--purple-400);
    box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.3);
  }

  .field [aria-invalid='true'] {
    border-color: #f87171;
  }

  .field-error {
    margin-top: 6px;
    font-size: 0.85rem;
    line-height: 1.4;
    color: #fca5a5;
  }

  .field-error:empty {
    display: none;
  }

  /* Off screen, not display: none, so form-filling bots still see it */
  .hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .form-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  /* Cap draws itself in a shadow root; these variables reach inside. The
     placeholder has the widget's exact size, so nothing moves when it loads. */
  .cap-slot {
    flex: 1 1 260px;
    max-width: 340px;
  }

  /* flex, not block: the widget's inline-block box would add line spacing below */
  cap-widget {
    display: flex;
    --cap-widget-width: 100%;
    --cap-widget-height: 56px;
    --cap-widget-padding: 14px;
    --cap-gap: 14px;
    --cap-background: rgb(16, 12, 26);
    --cap-border-color: var(--line-strong);
    --cap-border-radius: var(--radius-sm);
    --cap-color: var(--text);
    --cap-font: var(--font-body);
    --cap-checkbox-size: 24px;
    --cap-checkbox-border: 1px solid rgba(167, 139, 250, 0.55);
    --cap-checkbox-border-radius: 6px;
    --cap-checkbox-background: rgba(167, 139, 250, 0.08);
    --cap-spinner-color: var(--purple-400);
    --cap-spinner-background-color: rgba(167, 139, 250, 0.2);
    --cap-focus-ring: var(--purple-400);
  }

  .cap-placeholder {
    display: flex;
    flex: 1;
    align-items: center;
    gap: 14px;
    height: 56px;
    padding: 0 14px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    background: rgb(16, 12, 26);
    font-size: 15px;
    font-weight: 500;
    color: var(--text);
  }

  .cap-box {
    flex: none;
    width: 24px;
    height: 24px;
    border: 1px solid rgba(167, 139, 250, 0.55);
    border-radius: 6px;
    background: rgba(167, 139, 250, 0.08);
  }

  .send {
    border: 0;
    cursor: pointer;
  }

  .send:disabled {
    opacity: 0.65;
    cursor: progress;
    transform: none;
  }

  .form-status {
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--text-soft);
  }

  .form-status:empty {
    display: none;
  }

  .form-status.is-error {
    color: #fca5a5;
  }

  .form-note {
    font-size: 0.84rem;
    line-height: 1.5;
    color: var(--text-muted);
  }

  .form-note a {
    color: var(--purple-400);
    text-underline-offset: 3px;
  }

  .form-note a:hover {
    color: var(--purple-300);
  }

  .form-sent[hidden] {
    display: none;
  }

  .form-sent:focus {
    outline: none;
  }

  .form-sent p {
    color: var(--text-soft);
  }

  .form-sent .sent-title {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--text);
  }

  .direct-title {
    margin-top: clamp(36px, 5vh, 52px);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--purple-400);
  }

  /* Contact channels: logo, name, handle */
  .channel {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: rgba(13, 10, 22, 0.72);
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
  }

  .channel:hover,
  .channel:focus-within {
    border-color: var(--line-strong);
    box-shadow: 0 20px 50px -30px var(--glow);
  }

  a.channel:hover {
    transform: translateY(-2px);
  }

  .channel-link {
    display: flex;
    align-items: center;
    gap: 14px;
    min-width: 0;
    padding: 14px 16px;
    text-decoration: none;
  }

  .channel-icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line-strong);
    border-radius: 12px;
    background: linear-gradient(145deg, rgba(124, 58, 237, 0.34), rgba(46, 26, 92, 0.5));
    color: var(--purple-300);
    transition: color 0.2s, background 0.2s;
  }

  .channel-icon svg {
    width: 21px;
    height: 21px;
    fill: currentColor;
  }

  .channel:hover .channel-icon {
    background: var(--purple-500);
    color: #fff;
  }

  .channel-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .channel-label {
    font-family: var(--font-display);
    font-weight: 600;
    line-height: 1.3;
  }

  .channel-handle {
    font-size: 0.86rem;
    line-height: 1.45;
    color: var(--text-muted);
    overflow-wrap: break-word;
  }

  .channel-arrow {
    display: inline-block;
    color: var(--purple-400);
    transition: transform 0.2s;
  }

  .channel:hover .channel-arrow {
    transform: translate(2px, -2px);
  }

  /* Email is the main channel: full width, larger, with a copy button */
  .channel-email {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 14px;
    padding-right: 16px;
    border-color: var(--line-strong);
  }

  .channel-email .channel-link {
    flex: 1;
    padding-block: 18px;
  }

  .channel-email .channel-handle {
    font-size: clamp(0.92rem, 1.5vw, 1.1rem);
    color: var(--text);
  }

  .copy {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 8px;
