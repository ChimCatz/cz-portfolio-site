---
import { statSync } from 'node:fs';
import { dirname, join } from 'node:path';
import { render } from 'astro:content';
import DataGrowthChart from '../../components/DataGrowthChart.astro';
import JobMarketStory from '../../components/insights/JobMarketStory.astro';
import ReadingLayout from '../../layouts/ReadingLayout.astro';
import { entryHref, getNext, getSorted, readingTime, sectionHref, type ReadingEntry } from '../../lib/reading';

// Source data files live in each insight folder; Vite copies them into the build.
const datasetUrls = import.meta.glob<string>('../../content/insights/*/*.{zip,xlsx,pdf,csv}', {
  query: '?url',
  import: 'default',
  eager: true,
});

// Insights with charts or tools of their own name one of these in frontmatter `story`.
// The component brings the styles and script; the markup stays in the insight's index.md.
const stories = { 'job-market': JobMarketStory };

// Site components an insight can place in its text with <div data-embed="name"></div>.
// Markdown cannot hold a component, so each one is rendered after the article and
// moved into its spot as the page loads (without JavaScript it stays at the end).
const embeddable = { 'world-data': DataGrowthChart };

export async function getStaticPaths() {
  const insights = await getSorted('insights');
  return insights.map((insight) => ({
    params: { slug: insight.data.slug },
    props: { insight, next: getNext(insights, insight) },
  }));
}

interface Props {
  insight: ReadingEntry<'insights'>;
  next?: ReadingEntry<'insights'>;
}

const { insight, next } = Astro.props;
const { title, date, summary, banner, bannerAlt, highlights, tools, chapters, datasets, copyright, story } = insight.data;
const { Content } = await render(insight);
const Story = story && stories[story];
const embeds = Object.entries(embeddable).filter(([name]) => insight.body?.includes(`data-embed="${name}"`));

const folder = insight.filePath ? dirname(insight.filePath) : ''; // src/content/insights/<folder>
const downloads = datasets.map((dataset) => {
  const file = dataset.file.replace(/^\.\//, '');
  const href = datasetUrls[`../../${folder.replace(/^src\//, '')}/${file}`];
  if (!href) throw new Error(`Dataset file "${dataset.file}" not found for ${insight.id}`);
  const bytes = statSync(join(process.cwd(), folder, file)).size;
  const size = bytes >= 1e6 ? `${(bytes / 1e6).toFixed(1)} MB` : `${Math.ceil(bytes / 1e3)} KB`;
  return { ...dataset, file, href, type: file.split('.').pop()!.toUpperCase(), size };
});
---

<ReadingLayout
  title={title}
  summary={summary}
  date={date}
  minutes={readingTime(insight.body)}
  banner={banner}
  bannerAlt={bannerAlt}
  section={{ label: 'Insights', href: sectionHref('insights') }}
  next={next && {
    label: 'Next Insight',
    href: entryHref('insights', next),
    title: next.data.title,
    summary: next.data.summary,
  }}
>
  <div class:list={['insight-body', story && `story-${story}`]}>
    <Content />
    {embeds.map(([name, Embed]) => (
      <div class="embed" data-embed-from={name}><Embed /></div>
    ))}
    {embeds.length > 0 && (
      <script is:inline>
        document.querySelectorAll('[data-embed-from]').forEach(function (el) {
          var spot = document.querySelector('[data-embed="' + el.getAttribute('data-embed-from') + '"]');
          if (spot) spot.replaceWith(el);
        });
      </script>
    )}
  </div>

  {downloads.length > 0 && (
    <section class="downloads" id="data" aria-labelledby="data-heading">
      <p class="eyebrow">Source data</p>
      <h2 id="data-heading">Download the data</h2>
      <p class="downloads-intro">
        None of these files are mine. Each belongs to the organization or authors named with it and is
        offered here unchanged, so you can check the numbers or run your own analysis.
      </p>
      <ul class="download-list">
        {downloads.map((d) => (
          <li>
            <div class="dl-text">
              <h3>{d.name}</h3>
              <p class="dl-owner">{d.owner}</p>
              <p class="dl-detail">{d.detail}</p>
              <p class="dl-license">{d.license}</p>
            </div>
            <div class="dl-actions">
              <a class="btn btn-primary" href={d.href} download={d.file}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m0 0-5-5m5 5 5-5M5 21h14" /></svg>
                <span>Download <small>{d.type}, {d.size}</small></span>
              </a>
              <a class="dl-source" href={d.source} target="_blank" rel="noreferrer">
                Original source <span aria-hidden="true">↗</span>
              </a>
            </div>
          </li>
        ))}
      </ul>
    </section>
  )}

  {copyright && (
    <div class="prose-footnote"><strong>Copyright and data-use note:</strong> {copyright}</div>
  )}

  <!-- On phones the highlights and page links move above the article, the rest below it. -->
  {highlights.length > 0 && (
    <section class="side-block side-first" slot="side">
      <h2 class="side-heading">Highlights</h2>
      <ul class="highlights">
        {highlights.map((item) => <li>{item}</li>)}
      </ul>
    </section>
  )}
  {downloads.length > 0 && (
    <section class="side-block" slot="side">
      <h2 class="side-heading">Source data</h2>
      <div class="side-actions">
        <a class="btn btn-primary" href="#data">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m0 0-5-5m5 5 5-5M5 21h14" /></svg>
          <span>Download the data <small>{downloads.length} files, with credits</small></span>
        </a>
      </div>
      <p class="side-note">Not my data: each file belongs to its publisher.</p>
    </section>
  )}
  {chapters.length > 0 && (
    <nav class="side-block side-first" slot="side" aria-labelledby="chapters-heading">
      <h2 class="side-heading" id="chapters-heading">On this page</h2>
      <ol class="chapters">
        {chapters.map((chapter) => <li><a href={`#${chapter.id}`}>{chapter.label}</a></li>)}
      </ol>
    </nav>
  )}
  {tools.length > 0 && (
    <section class="side-block" slot="side">
      <h2 class="side-heading">Tools used</h2>
      <ul class="tool-list">
        {tools.map((tool) => <li>{tool}</li>)}
      </ul>
    </section>
  )}
</ReadingLayout>

{Story && <Story />}

<style>
  .highlights {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .highlights li {
    position: relative;
    padding-left: 18px;
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--text-soft);
  }

  .highlights li + li {
    margin-top: 10px;
  }

  .highlights li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--purple-500);
    box-shadow: 0 0 10px var(--glow);
  }

  /* "On this page": numbered links to the chapters */
  .chapters {
    display: grid;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: chapter;
  }

  .chapters li {
    counter-increment: chapter;
  }

  .chapters a {
    display: grid;
    grid-template-columns: 1.7em minmax(0, 1fr);
    font-size: 0.86rem;
    line-height: 1.45;
    text-decoration: none;
    color: var(--text-soft);
    transition: color 0.2s;
  }

  .chapters a::before {
    content: counter(chapter, decimal-leading-zero);
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1.75;
    color: var(--purple-400);
  }

  .chapters a:hover {
    color: var(--purple-300);
  }

  /* Under the "Download the data" button in the sidebar */
  .side-note {
    margin-top: 10px;
    font-size: 0.76rem;
    line-height: 1.5;
    color: var(--text-muted);
  }

  /* "Download the data": each file with its owner, licence and original source */
  .downloads {
    margin-top: 56px;
    padding-top: 28px;
    border-top: 1px solid var(--line);
  }

  /* The layout colors every paragraph in the article; the eyebrow keeps its own */
  .downloads .eyebrow {
    font-size: 0.8rem;
    line-height: 1.7;
    color: var(--purple-400);
  }

  .downloads h2 {
    margin-top: 10px;
    font-size: clamp(1.4rem, 2.6vw, 1.85rem);
    line-height: 1.2;
  }

  .downloads .downloads-intro {
    margin-top: 12px;
    font-size: 0.98rem;
    line-height: 1.7;
    color: var(--text-muted);
  }

  .download-list {
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }

  .download-list li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 14px 28px;
    padding: 18px 0;
    border-top: 1px solid var(--line);
  }

  .download-list li:last-child {
    border-bottom: 1px solid var(--line);
  }

  .download-list h3 {
    font-size: 1.05rem;
    line-height: 1.3;
  }

  .download-list p {
    margin-top: 0;
    font-size: 0.86rem;
    line-height: 1.55;
    color: var(--text-muted);
  }

  .download-list .dl-owner {
    margin-top: 3px;
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--purple-400);
  }

  .download-list .dl-detail {
    margin-top: 6px;
    color: var(--text-soft);
  }

  .download-list .dl-license {
    margin-top: 4px;
  }

  .dl-actions {
    display: grid;
    justify-items: start;
    gap: 8px;
    min-width: 172px;
  }

  .dl-actions .btn {
    justify-content: flex-start;
    gap: 10px;
    width: 100%;
    padding: 0.7em 1.1em;
    font-size: 0.85rem;
    line-height: 1.25;
  }

  .dl-actions svg {
    flex: none;
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .dl-actions small {
    display: block;
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 500;
    opacity: 0.8;
  }

  .dl-source {
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--purple-300);
    transition: color 0.2s;
  }

  .dl-source:hover {
    color: var(--text);
  }

  @media (max-width: 600px) {
    .download-list li {
      grid-template-columns: minmax(0, 1fr);
    }

    .dl-actions {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 8px 16px;
    }
  }

  /* Pull quote */
  .insight-body :global(blockquote) {
    margin: 32px 0;
    padding: 4px 0 4px 22px;
    border-left: 3px solid var(--purple-500);
  }

  .insight-body :global(blockquote p) {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2.2vw, 1.45rem);
    font-weight: 600;
    line-height: 1.45;
    color: var(--text);
  }

  .insight-body :global(blockquote + p) {
    margin-top: 0;
  }
</style>
