---
import type { ImageMetadata } from 'astro';
import { getImage, Image } from 'astro:assets';
import DataGrowthChart from '../components/DataGrowthChart.astro';
import Lightbox from '../components/Lightbox.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import profileImg from '../assets/about/cz-profile.jpg';
import certGa4Certification from '../assets/certificates/google-analytics-certification.png';
import certGa4GetStarted from '../assets/certificates/get-started-using-google-analytics.png';
import certGa4Reports from '../assets/certificates/google-analytics-reports-traffic-analysis.png';
import certGoogleAi from '../assets/certificates/google-ai.png';
import certGoogleDataAnalytics from '../assets/certificates/google-data-analytics.png';
import certGtm from '../assets/certificates/google-tag-manager.png';

// Live age counter. Same birth time as the old About page.
const BIRTH = '1999-12-29T01:00:00+08:00';
const YEAR_MS = 365.2425 * 24 * 60 * 60 * 1000;
const ageAtBuild = ((Date.now() - new Date(BIRTH).getTime()) / YEAR_MS).toFixed(9);

const facts = [
  { label: 'Based In', value: 'Cagayan de Oro City, Philippines' },
  { label: 'Role', value: 'Data Analyst' },
  { label: 'Focus', value: 'CRM data, reporting, dashboards, and automation' },
];

const socials = [
  { label: 'LinkedIn', handle: 'in/chimzoecatalan', href: 'https://www.linkedin.com/in/chimzoecatalan/' },
  { label: 'GitHub', handle: 'ChimCatz', href: 'https://github.com/ChimCatz' },
  { label: 'Facebook', handle: 'chimzoecatalan', href: 'https://fb.com/chimzoecatalan/' },
  { label: 'Email', handle: 'catalanchimzoe.business@gmail.com', href: 'mailto:catalanchimzoe.business@gmail.com' },
];

const kpis = [
  { value: '1+', label: 'Years in Data Analysis' },
  { value: '8+', label: 'Certifications and courses' },
  { value: '3+', label: 'Languages I automate with', detail: 'Python, SQL, VBA' },
  { value: '5+', label: 'Platforms I work in', detail: 'Zoho CRM, Zoho Analytics, Vtiger, GA4, GTM' },
];

// Tool logos: same-size PNGs made by `npm run logos` from source-files/logos/.
const logoFiles = import.meta.glob<{ default: ImageMetadata }>('../assets/logos/*.png', { eager: true });
const logo = (name: string) => logoFiles[`../assets/logos/${name}.png`].default;

// One tile per tool: [name, logo file, 'bleed' when the logo is a colored
// square that fills the tile (the rest sit inside a white tile)].
// The groups are sized to fill rows of 8 tiles on wide screens:
// 4 + 4, 7, 5 + 3, 8. Keep that in mind when adding or moving a tool.
type Tool = [name: string, logo: string, shape?: 'bleed'];
const toolGroups: { label: string; tools: Tool[] }[] = [
  {
    label: 'Languages',
    tools: [
      ['Python', 'python'],
      ['SQL', 'mysql'],
      ['VBA', 'visual-basic'],
      ['Zoho Deluge', 'zoho-deluge'],
    ],
  },
  {
    label: 'CRM & Email',
    tools: [
      ['Zoho CRM', 'zoho-crm'],
      ['Vtiger', 'vtiger'],
      ['Zoho Marketing Automation', 'zoho-marketing-automation'],
      ['Mailmeteor', 'mailmeteor', 'bleed'],
    ],
  },
  {
    label: 'Data & Reporting',
    tools: [
      ['Excel', 'excel'],
      ['Google Sheets', 'google-sheets'],
      ['BigQuery', 'bigquery'],
      ['Zoho Analytics', 'zoho-analytics'],
      ['Tableau', 'tableau'],
      ['pandas', 'pandas'],
      ['matplotlib', 'matplotlib'],
    ],
  },
  {
    label: 'Lead Data',
    tools: [
      ['Lusha', 'lusha', 'bleed'],
      ['Apollo', 'apollo', 'bleed'],
      ['Clay', 'clay'],
      ['Pipileads', 'pipileads', 'bleed'],
      ['ZeroBounce', 'zerobounce'],
    ],
  },
  {
    label: 'Web Analytics',
    tools: [
      ['Google Analytics 4', 'google-analytics'],
      ['Google Tag Manager', 'google-tag-manager'],
      ['Microsoft Clarity', 'microsoft-clarity'],
    ],
  },
  {
    label: 'AI & Workflow',
    tools: [
      ['Claude', 'claude'],
      ['Claude Code', 'claude-code'],
      ['Codex', 'codex'],
      ['ChatGPT', 'chatgpt', 'bleed'],
      ['Gemini', 'gemini'],
      ['VS Code', 'vscode'],
      ['Git', 'git'],
      ['GitHub', 'github'],
    ],
  },
];

// Certificates, newest first. Clicking one opens the whole image in the lightbox.
// `crop` is the certificate itself inside the image, as [x, y, width, height] in
// the image's own pixels (the Coursera files are screenshots with a summary
// panel on the left); the small preview shows only that part.
type Crop = [number, number, number, number];
const certificates: { title: string; type: string; issuer: string; date: string; image: ImageMetadata; crop: Crop }[] = [
  {
    title: 'Google Data Analytics',
    type: 'Professional Certificate · 9 courses',
    issuer: 'Google, via Coursera',
    date: 'May 2026',
    image: certGoogleDataAnalytics,
    crop: [601, 0, 527, 421],
  },
  {
    title: 'Google AI',
    type: 'Professional Certificate · 7 courses',
    issuer: 'Google, via Coursera',
    date: 'March 2026',
    image: certGoogleAi,
    crop: [595, 0, 527, 420],
  },
  {
    title: 'Google Tag Manager: Advanced Tracking & Analytics',
    type: 'Course certificate',
    issuer: 'LearnKartS, via Coursera',
    date: 'March 2026',
    image: certGtm,
    crop: [581, 0, 558, 425],
  },
  {
    title: 'Google Analytics: Reports & Traffic Analysis',
    type: 'Specialization · 8 courses',
    issuer: 'Coursera',
    date: 'February 2026',
    image: certGa4Reports,
    crop: [621, 112, 531, 454],
  },
  {
    title: 'Google Analytics Certification',
    type: 'Certification · valid to February 2027',
    issuer: 'Google',
    date: 'February 2026',
    image: certGa4Certification,
    crop: [0, 0, 631, 489],
  },
  {
    title: 'Get Started Using Google Analytics',
    type: 'Course completion',
    issuer: 'Google',
    date: 'February 2026',
    image: certGa4GetStarted,
    crop: [0, 0, 623, 491],
  },
];

// Preview frame shape (width / height). Certificates are close to it; the
// white frame fills whatever is left over.
const THUMB_RATIO = 4 / 3;
const pct = (n: number) => `${(n * 100).toFixed(3)}%`;

const certs = await Promise.all(
  certificates.map(async (cert) => {
    const [x, y, w, h] = cert.crop;
    const ratio = w / h;
    const full = await getImage({ src: cert.image, format: 'webp', quality: 90 });
    return {
      ...cert,
      full: full.src,
      caption: `${cert.title} · ${cert.issuer} · ${cert.date}`,
      // The crop, fitted whole inside the preview frame...
      windowStyle:
        ratio >= THUMB_RATIO ? `width:100%;height:${pct(THUMB_RATIO / ratio)}` : `height:100%;width:${pct(ratio / THUMB_RATIO)}`,
      // ...and the image scaled and shifted so only the crop shows through it.
      imageStyle: `width:${pct(cert.image.width / w)};left:${pct(-x / w)};top:${pct(-y / h)}`,
    };
  }),
);

const now = [
  'Going deeper on Python and SQL',
  'Exploring applied machine learning and generative AI',
  'Working toward data engineering',
  'Building this site as my personal lab',
];
---

<BaseLayout
  title="About Me | CZ Catalan"
  dimBackground
  description="CZ Catalan is an electronics engineer turned data analyst in Cagayan de Oro City, Philippines, working across CRM data, reporting, and dashboards with Python, SQL, and VBA."
>
  <div class="container about">
    <!-- Left 25%: photo and quick facts -->
    <aside class="about-profile" aria-label="Profile">
      <div class="photo">
        <Image
          src={profileImg}
          alt="Portrait of CZ Catalan"
          widths={[320, 480, 640]}
          sizes="(max-width: 860px) 200px, 280px"
          loading="eager"
        />
      </div>

      <dl class="facts">
        {facts.map((f) => (
          <div>
            <dt>{f.label}</dt>
            <dd>{f.value}</dd>
          </div>
        ))}
      </dl>
    </aside>

    <!-- Left 25% (continued): socials and KPIs -->
    <aside class="about-extras" aria-label="Links and highlights">
      <section>
        <h2 class="side-heading">Socials</h2>
        <ul class="socials">
          {socials.map((s) => (
            <li>
              <a href={s.href} target={s.href.startsWith('http') ? '_blank' : undefined} rel="noreferrer">
                <span class="social-label">{s.label}</span>
                <span class="social-handle">
                  {s.handle.includes('@') ? (
                    <Fragment>{s.handle.split('@')[0]}@<wbr />{s.handle.split('@')[1]}</Fragment>
                  ) : (
                    s.handle
                  )}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <section>
        <h2 class="side-heading">By the numbers</h2>
        <ul class="kpis">
          {kpis.map((k) => (
            <li>
              <span class="kpi-value" data-count>{k.value}</span>
              <span class="kpi-label">{k.label}</span>
              {k.detail && <span class="kpi-detail">{k.detail}</span>}
            </li>
          ))}
        </ul>
      </section>
    </aside>

    <!-- Right 75%: the story -->
    <article class="about-story">
      <h1>Everything comes down to <span class="gradient-text">data.</span></h1>

      <p class="lead">Hello, Welcome World! I'm Chim, but I go by <strong>CZ</strong>.</p>

      <p>
        I'm an electronics engineer who fell for data. I started out around circuits and signals, and
        stayed because the best systems, programs, and even AI models are only as good as the data
        behind them.
      </p>

      <p>
        I like the unglamorous middle of the process, where messy records become something people can
        trust and use. Along the way I learned that clean data is invisible when it works and painful
        when it doesn't, and that a repetitive task is usually just a script waiting to be written. I
        write those scripts in Python, SQL, and VBA, with AI as my pair programmer. I work under
        pressure, adapt fast, and don't get attached to a fixed workflow. I keep reading, trying
        things, and improving how I approach problems.
      </p>

      <p>
        I'm <span class="live-age" data-live-age data-birth={BIRTH}>{ageAtBuild}</span> years old in
        real time, based in Cagayan de Oro City, Philippines, and a graduate of Xavier University -
        Ateneo de Cagayan in Electronics and Communications Engineering, which sits somewhere between
        computers, electronics, and signals.
      </p>

      <section class="story-block">
        <h2>why data</h2>
        <p>
          There is more of it every year, and the climb is steep. Estimates of the world's data went
          from exabytes in the 1980s to zettabytes today, and somebody has to make sense of it.
        </p>
        <DataGrowthChart />
      </section>

      <section class="story-block">
        <h2>tools I reach for</h2>
        <div class="stack-panel">
          <div class="stack">
            {toolGroups.map((group) => (
              <div class="stack-group" style={`--n: ${group.tools.length}`}>
                <h3>{group.label}</h3>
                <ul>
                  {group.tools.map(([name, file, shape]) => (
                    <li>
                      <span class:list={['tool-logo', shape]}>
                        <Image src={logo(file)} alt="" width={96} />
                      </span>
                      <span class="tool-name">{name}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
        <p class="stack-note">
          Logos are trademarks of their owners, shown only to identify tools I use. No sponsorship or
          endorsement is implied.
        </p>
      </section>

      <section class="story-block">
        <h2>certifications</h2>
        <ul class="certs" data-lb-group>
          {certs.map((cert) => (
            <li>
              <button class="cert" type="button" data-lb-open>
                <span class="cert-thumb">
                  <span class="cert-window" style={cert.windowStyle}>
                    <Image
                      src={cert.image}
                      alt=""
                      width={800}
                      style={cert.imageStyle}
                      data-full={cert.full}
                      data-caption={cert.caption}
                    />
                  </span>
                </span>
                <span class="cert-text">
                  <span class="cert-title">{cert.title}</span>
                  <span class="cert-meta">{cert.issuer} · {cert.date}</span>
                  <span class="cert-type">{cert.type}</span>
                </span>
                <span class="cert-view" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"></path></svg>
                  View
                </span>
              </button>
            </li>
          ))}
        </ul>
      </section>

      <section class="story-block">
        <h2>now</h2>
        <ul class="now-list">
          {now.map((item) => <li>{item}</li>)}
        </ul>
      </section>

      <section class="story-block">
        <h2>outside the screen</h2>
        <p>
          I'm a gamer who goes for 100% completion in open-world games like Assassin's Creed and Far
          Cry. I also play Dota 2, League of Legends, and Valorant, and I've been a Pokémon fan for as
          long as I can remember.
        </p>
      </section>

      <section class="story-block">
        <h2>about this site</h2>
        <p>
          Designed and coded by me, with help from AI, in VSCode and hosted on GitHub Pages. It's still
          evolving, and I treat it like a lab for testing ideas.
        </p>
      </section>
    </article>
  </div>
</BaseLayout>

<Lightbox />

<script>
  const node = document.querySelector<HTMLElement>('[data-live-age]');
  if (node?.dataset.birth) {
    const birth = new Date(node.dataset.birth).getTime();
    const yearMs = 365.2425 * 24 * 60 * 60 * 1000;
    const update = () => {
      node.textContent = ((Date.now() - birth) / yearMs).toFixed(9);
    };
    update();
    // Reduced motion: tick once a second instead of every frame.
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      setInterval(update, 1000);
    } else {
      // About 30 times a second while it is on screen (the last digit changes
      // about every 32 ms, so more often would redraw the same text); stopped
      // while scrolled away.
      let visible = true;
      let frame = 0;
      let last = 0;
      const loop = (now: number) => {
        if (now - last >= 30) {
          last = now;
          update();
        }
        frame = visible ? requestAnimationFrame(loop) : 0;
      };
      if ('IntersectionObserver' in window) {
        new IntersectionObserver(([entry]) => {
          visible = entry.isIntersecting;
          if (visible && !frame) frame = requestAnimationFrame(loop);
        }).observe(node);
      }
      frame = requestAnimationFrame(loop);
    }
  }
</script>

<style>
  /* 25% / 75% split. The left column holds two blocks (profile, extras)
     so on phones the story can sit between them. */
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
    grid-template-rows: auto 1fr;
    grid-template-areas:
      'profile story'
      'extras  story';
    column-gap: clamp(32px, 5vw, 72px);
    padding-top: calc(var(--header-h) + clamp(32px, 6vh, 64px));
    padding-bottom: 96px;
  }

  .about-profile {
    grid-area: profile;
  }

  .about-extras {
    grid-area: extras;
    align-self: start;
  }

  .about-story {
    grid-area: story;
  }

  /* Readable panel over the globe for the left column */
  .about-profile,
  .about-extras {
    background: rgba(13, 10, 22, 0.72);
    border: 1px solid var(--line);
    padding: 16px;
  }

  .about-profile {
    border-radius: var(--radius) var(--radius) 0 0;
    border-bottom: 0;
  }

  .about-extras {
    border-radius: 0 0 var(--radius) var(--radius);
    border-top: 0;
    padding-top: 8px;
  }

  /* Photo */
  .photo {
    overflow: hidden;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line-strong);
    box-shadow: 0 18px 48px -20px var(--glow);
  }

  .photo img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  /* Facts */
  .facts {
    margin: 20px 0 0;
  }

  .facts div + div {
    margin-top: 14px;
  }

  .facts dt,
  .side-heading {
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--purple-400);
  }

  .facts dd {
    margin: 2px 0 0;
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--text);
  }

  .about-extras section {
    padding-top: 20px;
    margin-top: 20px;
    border-top: 1px solid var(--line);
  }

  .about-extras section:first-child {
    margin-top: 12px;
  }

  .side-heading {
    margin-bottom: 10px;
  }

  /* Socials */
  .socials {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .socials a {
    display: flex;
    flex-direction: column;
    padding: 8px 10px;
    margin-inline: -10px;
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: background 0.2s;
  }

  .socials a:hover {
    background: rgba(124, 58, 237, 0.14);
  }

  .social-label {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.95rem;
  }

  .social-label::after {
    content: ' ↗';
    color: var(--purple-400);
  }

  .social-handle {
    font-size: 0.8rem;
    color: var(--text-muted);
    overflow-wrap: break-word;
  }

  /* KPIs */
  .kpis {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
  }

  .kpis li {
    display: flex;
    flex-direction: column;
  }

  .kpi-value {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.1;
    background: var(--brand-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .kpi-label {
    font-size: 0.88rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .kpi-detail {
    margin-top: 2px;
    font-size: 0.78rem;
    line-height: 1.45;
    color: var(--text-muted);
  }

  /* Story */
  .about-story {
    max-width: 72ch;
    padding: clamp(0px, 1vw, 8px) 0;
  }

  .about-story h1 {
    margin-top: 0;
    font-size: clamp(2.2rem, 5vw, 3.75rem);
  }

  .about-story > p,
  .story-block p {
    margin-top: 18px;
    color: var(--text-soft);
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .about-story > .lead {
    margin-top: 28px;
    font-size: clamp(1.15rem, 2vw, 1.35rem);
    color: var(--text);
  }

  .lead strong {
    color: var(--purple-300);
  }

  .live-age {
    font-family: var(--font-display);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--purple-300);
  }

  .story-block {
    margin-top: 44px;
    padding-top: 28px;
    border-top: 1px solid var(--line);
  }

  /* Section labels: gradient rule + spaced caps, e.g. "—— NOW" */
  .story-block h2 {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--purple-300);
  }

  .story-block h2::before {
    content: '';
    width: 36px;
    height: 2px;
    border-radius: 2px;
    background: var(--brand-gradient);
    box-shadow: 0 0 10px var(--glow);
  }

  /* Tools I reach for: a panel of logo tiles, every tile the same size, in
     named groups. The panel is 8 tiles wide when it has the room (groups sit
     side by side: 4 + 4, 7, 5 + 3, 8) and 4 wide when it doesn't, where each
     group takes the full width. It answers to its own width, not the screen's. */
  .stack-panel {
    container-type: inline-size;
    margin-top: 22px;
    padding: 20px 16px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: rgba(19, 15, 31, 0.6);
  }

  .stack {
    --cols: 4;
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: 26px 8px;
  }

  .stack-group {
    grid-column: 1 / -1;
  }

  .stack-group h3 {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-left: 4px;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--text);
  }

  .stack-group h3::before {
    content: '';
    width: 18px;
    height: 1px;
    background: var(--purple-400);
  }

  .stack-group ul {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: 16px 8px;
    list-style: none;
    margin: 14px 0 0;
    padding: 0;
  }

  @container (min-width: 600px) {
    .stack {
      --cols: 8;
    }

    .stack-group {
      grid-column: span var(--n);
    }

    .stack-group ul {
      grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    }
  }

  .stack-group li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  /* Every logo sits in the same white tile, so marks made for light
     backgrounds stay readable on this dark page */
  .tool-logo {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    padding: 9px;
    overflow: hidden;
    border-radius: 12px;
    background: #fff;
    box-shadow: 0 10px 22px -14px rgba(0, 0, 0, 0.9);
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .tool-logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* Logos that are already a colored square fill the tile */
  .tool-logo.bleed {
    padding: 0;
  }

  .tool-logo.bleed img {
    object-fit: cover;
  }

  .stack-group li:hover .tool-logo {
    transform: translateY(-2px);
    box-shadow: 0 14px 26px -12px var(--glow);
  }

  .tool-name {
    font-family: var(--font-display);
    font-size: 0.74rem;
    font-weight: 500;
    line-height: 1.3;
    text-align: center;
    overflow-wrap: anywhere;
    color: var(--text-soft);
  }

  .story-block .stack-note {
    margin-top: 12px;
    font-size: 0.78rem;
    line-height: 1.6;
    color: var(--text-muted);
  }

  /* Certifications: one row each (preview, name, issuer). The row opens the image. */
  .certs {
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
  }

  .certs li + li {
    border-top: 1px solid var(--line);
  }

  .cert {
    display: grid;
