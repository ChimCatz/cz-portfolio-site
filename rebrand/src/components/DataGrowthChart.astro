---
// Estimated size of the world's data by year, 1968 to 2030, drawn at build time
// from src/data/world-data-1968-2030.csv, with the eras and milestones in
// src/data/world-data-eras.csv. Used on About Me and in the "Why Data Pulled Me
// In" insight.
//
// The figures are estimates, so the chart says so: the line is dashed where it
// is extended back before the first measurement (1986) or forecast after the
// latest actual figure (2023), and every year's readout and table row says what
// kind of figure it is. The area under the line is split into eras of
// technology.
//
// The lines are an SVG stretched to the plot; every label is HTML placed by
// percentage, so text stays the same size on a phone. Milestone names are written
// inside their era's band by the script below when they all fit; otherwise (on
// phones, and without JavaScript) they are listed under each era in the key.
import dataCsv from '../data/world-data-1968-2030.csv?raw';
import erasCsv from '../data/world-data-eras.csv?raw';

/** Rows of a small CSV file, with quoted fields. */
function parseCsv(text: string): string[][] {
  return text
    .trim()
    .split(/\r?\n/)
    .slice(1)
    .map((line) => {
      const cells: string[] = [];
      let cell = '';
      let quoted = false;
      for (let i = 0; i < line.length; i++) {
        const c = line[i];
        if (quoted && c === '"' && line[i + 1] === '"') cell += line[++i];
        else if (c === '"') quoted = !quoted;
        else if (c === ',' && !quoted) cells.push(cell), (cell = '');
        else cell += c;
      }
      return [...cells, cell];
    });
}

// Up the side: 10 PB to 1,000 ZB, as powers of ten in exabytes. The extra decade
// at the bottom makes the early bands tall enough to write in.
const Y_MIN = -2;
const Y_MAX = 6;
const TICKS = ['10 PB', '100 PB', '1 EB', '10 EB', '100 EB', '1 ZB', '10 ZB', '100 ZB', '1,000 ZB'].map((label, i) => ({
  exp: Y_MIN + i,
  label,
}));

const BASIS: Record<string, { label: string; published: boolean }> = {
  backcast: { label: 'Estimate, extended back at 20% a year', published: false },
  hilbert: { label: 'Storage capacity, Hilbert and López', published: true },
  interpolated: { label: 'Filled in between published figures', published: false },
  statista: { label: 'Data created, Statista (IDC)', published: true },
  statista_unverified: { label: 'Data created, Statista (IDC), read from a chart', published: true },
  statista_forecast: { label: 'Forecast, Statista (IDC)', published: true },
  extrapolated: { label: 'Forecast, extended at 26% a year', published: false },
};

/** 2.6 -> "2.6 EB", 625514 -> "626 ZB" (input in exabytes) */
function amount(eb: number): string {
  const sig = (n: number, s: number) => Number(n.toPrecision(s)).toLocaleString('en-US');
  if (eb >= 1000) return `${sig(eb / 1000, eb >= 100000 ? 3 : 2)} ZB`;
  if (eb >= 1) return `${sig(eb, eb >= 100 ? 3 : 2)} EB`;
  return `${sig(eb * 1000, 2)} PB`;
}

const rows = parseCsv(dataCsv).map(([year, eb, , , basis, style]) => {
  if (!BASIS[basis]) throw new Error(`Unknown basis "${basis}" in the world data file`);
  return { year: Number(year), eb: Number(eb), basis, dashed: style === 'dashed', ...BASIS[basis] };
});

const FROM = rows[0].year;
const TO = rows[rows.length - 1].year;
const xOf = (year: number) => ((year - FROM) / (TO - FROM)) * 100;
const yOf = (exp: number) => 100 - ((exp - Y_MIN) / (Y_MAX - Y_MIN)) * 100;
const points = rows.map((row) => ({
  ...row,
  x: +xOf(row.year).toFixed(3),
  y: +yOf(Math.log10(row.eb)).toFixed(3),
  text: (row.published ? '' : '≈') + amount(row.eb),
}));
const at = (year: number) => points.find((p) => p.year === year)!;

// Eras: each runs from its first year up to the next era's first year (the last
// one to the end of the chart), so the bands meet.
const COLORS: Record<string, string> = { e1: '#3987e5', e2: '#d95926', e3: '#199e70', e4: '#c98500', e5: '#d55181' };
const eras: { name: string; from: number; to: number; color: string; milestones: { year: number; name: string; text: string }[] }[] = [];
for (const [name, from, , token, year, milestone, text] of parseCsv(erasCsv)) {
  let era = eras.find((e) => e.name === name);
  if (!era) eras.push((era = { name, from: Number(from), to: 0, color: COLORS[token], milestones: [] }));
  era.milestones.push({ year: Number(year), name: milestone, text });
}
const ERAS = eras.map((era, i) => {
  const to = eras[i + 1]?.from ?? TO;
  const [a, b] = [at(era.from), at(to)];
  // How many times the world's data multiplied; approximate where an end is an estimate or forecast
  const times = `${a.dashed || b.dashed ? '≈' : ''}×${Math.round(b.eb / a.eb)}`;
  const end = i === eras.length - 1 ? to : to - 1;
  const years = `${era.from}–${Math.floor(end / 100) === Math.floor(era.from / 100) ? String(end).slice(2) : end}`;
  // The band: the curve across the era, closed along the bottom
  const edge = points.filter((p) => p.year >= era.from && p.year <= to);
  const band = `M${edge.map((p) => `${p.x} ${p.y}`).join(' L')} L${b.x} 100 L${a.x} 100 Z`;
  return { ...era, to, times, years, band, x: a.x, width: +(b.x - a.x).toFixed(3) };
});
const eraOf = (year: number) => ERAS.find((e, i) => year >= e.from && (year < e.to || i === ERAS.length - 1))!;

// The line, in solid and dashed stretches: a step that touches a dashed year is dashed
const stretches: { dashed: boolean; d: string }[] = [];
for (let i = 1; i < points.length; i++) {
  const [a, b] = [points[i - 1], points[i]];
  const dashed = a.dashed || b.dashed;
  const last = stretches[stretches.length - 1];
  if (last?.dashed === dashed) last.d += ` L${b.x} ${b.y}`;
  else stretches.push({ dashed, d: `M${a.x} ${a.y} L${b.x} ${b.y}` });
}

const milestoneYears = [...new Set(ERAS.flatMap((e) => e.milestones.map((m) => m.year)))].map(at);
const firstMeasured = points.find((p) => p.basis === 'hilbert')!;
const latestActual = [...points].reverse().find((p) => p.basis === 'statista' || p.basis === 'statista_unverified')!;
const last = points[points.length - 1];
// The three values written on the chart, each above and to the left of its point
const KEYS = [
  { p: firstMeasured, note: `${firstMeasured.year}, first measured` },
  { p: latestActual, note: `${latestActual.year}, latest actual` },
  { p: last, note: `${last.year} forecast` },
];
const decades = points.filter((p) => p.year % 10 === 0);
const growthAll = Number((latestActual.eb / firstMeasured.eb).toPrecision(2));

const hover = points.map((p) => {
  const era = eraOf(p.year);
  return {
    year: p.year,
    text: p.text,
    label: p.label,
    era: era.name,
    color: era.color,
    milestones: era.milestones.filter((m) => m.year === p.year).map((m) => [m.name, m.text]),
    x: p.x,
    y: p.y,
  };
});
// What the script needs to fit the milestone names under the line
const layout = {
  curve: points.map((p) => [p.x, p.y]),
  eras: ERAS.map((e) => [e.x, e.x + e.width]),
};
---

<figure class="growth">
  <figcaption class="growth-head">
    <strong>The world's data, {FROM} to {TO}</strong>
    <span>Estimates, log scale: each line is 10 times the one below.</span>
  </figcaption>

  <ol class="growth-eras">
    {ERAS.map((era) => (
      <li style={`--era:${era.color}`}>
        <i class="era-swatch"></i>
        <div>
          <span class="era-meta">{era.years} · {era.times}</span>
          <b class="era-name">{era.name}</b>
          <span class="era-ms">{era.milestones.map((m) => `${m.name} ${m.year}`).join(' · ')}</span>
        </div>
      </li>
    ))}
  </ol>

  <div class="growth-frame">
    <div
      class="growth-plot"
      data-growth={JSON.stringify(hover)}
      data-layout={JSON.stringify(layout)}
      tabindex="0"
      role="img"
      aria-label={`Line chart on a log scale: about ${amount(points[0].eb)} in ${FROM} (an estimate), ${firstMeasured.text} in ${firstMeasured.year}, ${latestActual.text} in ${latestActual.year}, and a forecast of ${last.text} for ${TO}. The area under the line is split into ${ERAS.length} eras: ${ERAS.map((e) => `${e.name} (${e.years}, ${e.times})`).join(', ')}. Use the left and right arrow keys to read each year.`}
    >
      <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
        {TICKS.map((tick) => <line class="grid" x1="0" x2="100" y1={yOf(tick.exp)} y2={yOf(tick.exp)}></line>)}
        {ERAS.map((era) => <path class="band" style={`--era:${era.color}`} d={era.band}></path>)}
        {ERAS.slice(1).map((era) => (
          <line class="band-gap" x1={era.x} x2={era.x} y1={at(era.from).y} y2="100"></line>
        ))}
        {stretches.map((s) => <path class:list={['stretch', { dashed: s.dashed }]} d={s.d}></path>)}
      </svg>

      {TICKS.map((tick) => (
        <span class:list={['tick', { 'tick-minor': (tick.exp - Y_MIN) % 2 }]} style={`top:${yOf(tick.exp)}%`}>{tick.label}</span>
      ))}

      <!-- Milestone names inside the bands, under the line (placed by the script below) -->
      <div class="ms-layer" aria-hidden="true" hidden>
        {ERAS.map((era, e) =>
          era.milestones.map((m) => (
            <span class="ms" data-era={e}>
              <small>{m.year}</small>
              {m.name}
            </span>
          )),
        )}
      </div>

      {milestoneYears.map((p) => <i class="ring" style={`left:${p.x}%;top:${p.y}%`}></i>)}
      {KEYS.map(({ p, note }) => (
        <>
          <i class:list={['dot', { 'dot-open': p.dashed }]} style={`left:${p.x}%;top:${p.y}%`}></i>
          <span class="value" style={`left:${p.x}%;top:${p.y}%`}>
            <b>{p.text}</b>
            <small>{note}</small>
          </span>
        </>
      ))}

      <!-- Hover and keyboard readout (placed by the script below) -->
      <i class="cross" hidden></i>
      <i class="dot dot-live" hidden></i>
      <div class="tip" hidden>
        <span class="tip-year"><i data-tip-swatch></i><span data-tip-year></span></span>
        <b data-tip-value></b>
        <small data-tip-kind></small>
        <div data-tip-ms></div>
      </div>
    </div>

    <div class="growth-years" aria-hidden="true">
      {decades.map((p) => <span style={`left:${p.x}%`}>{p.year}</span>)}
    </div>
  </div>

  <p class="growth-legend"><i class="key-dashed"></i>Dashed: estimate or forecast</p>

  <details class="growth-more">
    <summary>About these numbers</summary>
    <div class="growth-more-body">
      <p>
        Estimates, not measurements: about {growthAll.toLocaleString('en-US')}-fold growth from
        {firstMeasured.year} to {latestActual.year}.
      </p>
      <ul>
        <li>
          <b>Up to 2007:</b> the world's capacity to store information, analog and digital (Hilbert and
          López, <i>Science</i>, 2011). Years between their figures are filled in.
        </li>
        <li>
          <b>From 2010:</b> data created, captured, copied and consumed each year (Statista, based on
          IDC). It counts every copy and stream, so part of the 2007 to 2010 jump is a change in what is
          counted.
        </li>
        <li>
          <b>Dashed:</b> before {firstMeasured.year}, extended back at 20% a year. After
          {latestActual.year}, Statista's forecast to 2028, then about 26% a year.
        </li>
      </ul>
      <div class="growth-table-scroll">
        <table>
          <thead>
            <tr><th scope="col">Year</th><th scope="col">World data</th><th scope="col">Era</th><th scope="col">Kind of figure</th></tr>
          </thead>
          <tbody>
            {points.map((p) => (
              <tr><td>{p.year}</td><td>{p.text}</td><td>{eraOf(p.year).name}</td><td>{p.label}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </details>
</figure>

<script>
  type Point = {
    year: number;
    text: string;
    label: string;
    era: string;
    color: string;
    milestones: [string, string][];
    x: number;
    y: number;
  };
  type Layout = { curve: [number, number][]; eras: [number, number][] };

  // Milestone names go inside the bands only on a plot at least this wide
  const MIN_WIDTH = 480;
  const PAD = 3; // from the band's edges and the bottom, in px
  const GAP = 5; // between stacked names
  const CLEAR = 6; // between a name and the line above it

  document.querySelectorAll<HTMLElement>('[data-growth]').forEach((plot) => {
    const points: Point[] = JSON.parse(plot.dataset.growth ?? '[]');
    const layout: Layout = JSON.parse(plot.dataset.layout ?? '{}');
    const figure = plot.closest<HTMLElement>('.growth');
    const cross = plot.querySelector<HTMLElement>('.cross');
    const live = plot.querySelector<HTMLElement>('.dot-live');
    const tip = plot.querySelector<HTMLElement>('.tip');
    const layer = plot.querySelector<HTMLElement>('.ms-layer');
    if (!points.length || !figure || !cross || !live || !tip || !layer) return;

    // ---- Milestone names inside the bands ----
    const names = [...layer.querySelectorAll<HTMLElement>('.ms')];
    // The line's height (in % from the top) at a point across the plot (in %)
    const curveAt = (x: number) => {
      const c = layout.curve;
      let i = 0;
      while (i < c.length - 2 && c[i + 1][0] < x) i++;
      const [[xa, ya], [xb, yb]] = [c[i], c[i + 1]];
      return ya + ((yb - ya) * (x - xa)) / (xb - xa);
    };

    let placedWidth = 0;
    const place = () => {
      const width = plot.clientWidth;
      const height = plot.clientHeight;
      if (width === placedWidth) return;
      placedWidth = width;
      const banded = (fits: boolean) => {
        figure.classList.toggle('is-banded', fits);
        layer.hidden = !fits;
      };
      if (width < MIN_WIDTH) return banded(false);

      // Each name may wrap to its band's width: set that, then measure every name at once
      const inner = (e: number) => ((layout.eras[e][1] - layout.eras[e][0]) / 100) * width - 2 * PAD;
      layer.hidden = false;
      names.forEach((el) => (el.style.maxWidth = `${inner(Number(el.dataset.era))}px`));
      // (offsetWidth rounds to whole pixels, so the width check below allows one)
      const sizes = names.map((el) => [el.offsetWidth - 1, el.offsetHeight, el.scrollWidth - el.clientWidth]);

      // Stack each era's names up from the bottom, each as far left as the line allows
      const spots: [number, number][] = [];
      const stack: Record<number, number> = {};
      const fits = names.every((el, i) => {
        const e = Number(el.dataset.era);
        const [w, h, overflow] = sizes[i];
        const top = (stack[e] ?? height - PAD) - h;
        stack[e] = top - GAP;
        const start = (layout.eras[e][0] / 100) * width + PAD;
        const end = (layout.eras[e][1] / 100) * width - PAD;
        // The line only climbs, so the first spot where it clears the name's top is the leftmost
        let x = start;
        while (x + w <= end && (curveAt((x / width) * 100) / 100) * height > top - CLEAR) x += 1;
        spots.push([x, top]);
        return overflow <= 0 && x + w <= end;
      });

      if (fits) names.forEach((el, i) => (el.style.translate = `${spots[i][0]}px ${spots[i][1]}px`));
      banded(fits);
    };

    // Text widths are only known once the fonts are in; resizes are handled once per frame
    let queued = false;
    const queue = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        place();
      });
    };
    document.fonts.ready.then(() => {
      queue();
      new ResizeObserver(queue).observe(plot);
    });

    // ---- Hover and keyboard readout ----
    const swatch = tip.querySelector<HTMLElement>('[data-tip-swatch]')!;
    const value = tip.querySelector('[data-tip-value]')!;
    const year = tip.querySelector('[data-tip-year]')!;
    const kind = tip.querySelector('[data-tip-kind]')!;
    const milestones = tip.querySelector('[data-tip-ms]')!;
    let current = -1;

    const show = (i: number) => {
      current = Math.max(0, Math.min(points.length - 1, i));
      const p = points[current];
      swatch.style.background = p.color;
      year.textContent = `${p.year} · ${p.era}`;
      value.textContent = p.text;
      kind.textContent = p.label;
      milestones.replaceChildren(
        ...p.milestones.map(([name, text]) => {
          const line = document.createElement('p');
          line.append(Object.assign(document.createElement('b'), { textContent: `${name}.` }), ` ${text}`);
          return line;
        }),
      );
      cross.style.left = live.style.left = `${p.x}%`;
      live.style.top = `${p.y}%`;
      cross.hidden = live.hidden = tip.hidden = false;
      // The readout sits beside the point, on whichever side has room, and never leaves the plot
      const box = plot.getBoundingClientRect();
      const px = (p.x / 100) * box.width;
      const py = (p.y / 100) * box.height;
      const left = px + 14 + tip.offsetWidth > box.width ? px - 14 - tip.offsetWidth : px + 14;
      const top = Math.max(0, Math.min(box.height - tip.offsetHeight, py - tip.offsetHeight - 10));
      tip.style.left = `${Math.max(0, left)}px`;
      tip.style.top = `${top}px`;
    };

    const hide = () => {
      current = -1;
      cross.hidden = live.hidden = tip.hidden = true;
    };

    // Pointer moves can fire several times a frame: handle only the latest, once per frame.
    let pointerX = 0;
    let tracking = false;
    const track = () => {
      tracking = false;
      if (Number.isNaN(pointerX)) return; // the pointer left before this frame
      const box = plot.getBoundingClientRect();
      const x = ((pointerX - box.left) / box.width) * 100;
      let nearest = 0;
      points.forEach((p, i) => {
        if (Math.abs(p.x - x) < Math.abs(points[nearest].x - x)) nearest = i;
      });
      if (nearest !== current) show(nearest);
    };
    plot.addEventListener('pointermove', (event) => {
      pointerX = event.clientX;
      if (!tracking) {
        tracking = true;
        requestAnimationFrame(track);
      }
    });
    plot.addEventListener('pointerleave', () => {
      pointerX = NaN;
      hide();
    });
    plot.addEventListener('blur', hide);
    plot.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') return hide();
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
      event.preventDefault();
      const step = event.key === 'ArrowRight' ? 1 : -1;
      show(current < 0 ? (step > 0 ? 0 : points.length - 1) : current + step);
    });
  });
</script>

<style>
  .growth {
    container-type: inline-size;
    margin: 22px 0 0;
    padding: 20px 18px 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: rgba(19, 15, 31, 0.6);
  }

  .growth .growth-head {
    margin: 0;
  }

  .growth-head strong {
    display: block;
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--text);
  }

  .growth-head span {
    display: block;
    margin-top: 4px;
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--text-muted);
  }

  /* Eras: the key to the coloured bands. One row of five on a wide panel, a list on a narrow one. */
  .growth-eras {
    display: grid;
    gap: 12px;
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
  }

  .growth-eras li {
    display: grid;
    grid-template-columns: 10px 1fr;
    gap: 10px;
    margin: 0;
    padding: 0;
    font-size: 0.8rem;
    line-height: 1.4;
  }

  .growth-eras li::before {
    content: none;
  }

  .era-swatch {
    border-radius: 3px;
    background: var(--era);
  }

  .era-meta {
    display: block;
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
    color: var(--text-muted);
  }

  .era-name {
    display: block;
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--text);
  }

  .era-ms {
    display: block;
    margin-top: 2px;
    color: var(--text-soft);
  }

  /* The milestone names are written inside the bands instead */
  .is-banded .era-ms {
    display: none;
  }

  @container (min-width: 600px) {
    .growth-eras {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 14px;
    }

    .growth-eras li {
      grid-template-columns: 1fr;
      grid-template-rows: 5px auto;
      gap: 8px;
    }
  }

  /* Plot, with room on the left for the scale */
  .growth-frame {
    padding: 0 16px 0 48px;
    margin-top: 40px;
  }

  .growth-plot {
    position: relative;
    aspect-ratio: 3 / 2;
    cursor: crosshair;
    touch-action: pan-y;
  }

  .growth-plot svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /* The SVG is stretched, so strokes keep their own width instead of stretching with it */
  .growth-plot :is(line, path) {
    vector-effect: non-scaling-stroke;
  }

  .grid {
    stroke: var(--line);
    stroke-width: 1;
  }

  .band {
    fill: var(--era);
    fill-opacity: 0.3;
  }

  /* A thin gap between neighbouring bands, in the panel colour */
  .band-gap {
    stroke: #110d1c;
    stroke-width: 2;
  }

  .stretch {
    fill: none;
    stroke: var(--text);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .stretch.dashed {
    stroke-dasharray: 5 5;
    stroke-linecap: butt;
  }

  /* The scale, in the space to the left of the plot */
  .tick {
    position: absolute;
    right: calc(100% + 8px);
    translate: 0 -50%;
    font-family: var(--font-display);
    font-size: 0.68rem;
    font-weight: 500;
    line-height: 1;
    white-space: nowrap;
    color: var(--text-faint);
    pointer-events: none;
  }

  /* Milestone names, under the line in their era's band */
  .ms-layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .ms {
    position: absolute;
    top: 0;
    left: 0;
    width: max-content;
    overflow: hidden;
    font-family: var(--font-display);
    font-size: 0.68rem;
    font-weight: 600;
    line-height: 1.2;
    color: var(--text);
  }

  .ms small {
    display: block;
    font-size: 0.62rem;
    font-weight: 400;
    color: var(--text-soft);
