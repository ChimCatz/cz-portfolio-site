---
// Site footer, on every page. It must stay under 10% of the screen height on
// every screen (a rule from the user), so it is a few short lines of small
// text and drops lines as the screen gets shorter:
//
//   wide screens     2 lines: wordmark, page links, contact  /  copyright, terms
//                    1 line when the screen is under 620px tall
//   narrow screens   3 lines: page links  /  contact, terms  /  copyright
//                    2 lines under 740px tall (page links go; the header has them)
//                    1 line under 520px tall
//
// Anything added here has to fit those lines: check the footer's height
// against the screen height at several sizes before calling it done.
import { CONTACT_LINK, EMAIL, HOME_HREF, ICONS, NAV_LINKS, SOCIALS, TERMS_LINK } from '../lib/site';

const [emailName, emailDomain] = EMAIL.split('@');
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <a class="wordmark" href={HOME_HREF} aria-label="cz.catzzz, back to home">
      cz<span class="wordmark-dot">.</span>catzzz
    </a>

    <nav class="footer-nav" aria-label="Footer">
      <ul>
        {NAV_LINKS.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
        <li class="nav-contact"><a href={CONTACT_LINK.href}>{CONTACT_LINK.label}</a></li>
      </ul>
    </nav>

    <ul class="footer-contact" aria-label="Contact">
      <li>
        <a class="footer-email" href={`mailto:${EMAIL}`} aria-label={`Email ${EMAIL}`} title="Email">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d={ICONS.gmail}></path></svg>
          <span>{emailName}@{emailDomain}</span>
        </a>
      </li>
      {SOCIALS.map((s) => (
        <li>
          <a href={s.href} target="_blank" rel="noopener" aria-label={s.label} title={s.label}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d={s.icon}></path></svg>
          </a>
        </li>
      ))}
    </ul>

    <p class="footer-legal">© {year} Chim Zoe Catalan<span class="legal-rights">. All rights reserved.</span></p>

    <a class="footer-terms" href={TERMS_LINK.href}>{TERMS_LINK.label}</a>
  </div>
</footer>

<style>
  /* Solid enough to read over the globe on the homepage */
  .site-footer {
    border-top: 1px solid var(--line);
    background: rgba(7, 5, 12, 0.82);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    font-size: 0.78rem;
    line-height: 1.4;
    color: var(--text-muted);
  }

  /* Wide screens: two lines */
  .footer-inner {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    grid-template-areas:
      'brand nav   contact'
      'legal legal terms';
    align-items: center;
    gap: 4px 28px;
    padding-block: 8px;
  }

  .wordmark {
    grid-area: brand;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.25;
    color: var(--text);
    text-decoration: none;
  }

  .wordmark-dot {
    color: var(--purple-400);
  }

  .footer-nav {
    grid-area: nav;
  }

  .footer-nav ul,
  .footer-contact {
    display: flex;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer-nav ul {
    gap: 4px 18px;
  }

  .footer-contact {
    grid-area: contact;
    gap: 2px;
  }

  .footer-legal {
    grid-area: legal;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .footer-terms {
    grid-area: terms;
    justify-self: end;
  }

  .site-footer a {
    color: var(--text-soft);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.2s;
  }

  .site-footer a:hover {
    color: var(--purple-300);
  }

  .site-footer .wordmark {
    color: var(--text);
  }

  /* Contact: icons; the address is spelled out when there is room */
  .footer-contact a {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 2px 4px;
  }

  .footer-contact svg {
    flex: none;
    width: 16px;
    height: 16px;
    fill: currentColor;
  }

  .footer-email {
    margin-right: 6px;
  }

  @media (max-width: 1100px) {
    .footer-email {
      margin-right: 0;
    }

    .footer-email span {
      display: none;
    }
  }

  /* Wide but short screens: one line */
  @media (min-width: 861px) and (max-height: 619px) {
    .footer-inner {
      grid-template-columns: auto minmax(0, 1fr) auto auto;
      grid-template-areas: 'legal nav contact terms';
      padding-block: 5px;
    }

    .wordmark,
    .legal-rights,
    .footer-email span {
      display: none;
    }

    .footer-email {
      margin-right: 0;
    }
  }

  @media (min-width: 861px) and (max-width: 1100px) and (max-height: 619px) {
    .nav-contact {
      display: none;
    }
  }

  /* Narrow screens: three lines */
  @media (max-width: 860px) {
    .site-footer {
      font-size: clamp(0.66rem, 3.1vw, 0.72rem);
    }

    .footer-inner {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        'nav     nav'
        'contact terms'
        'legal   legal';
      gap: 3px 16px;
      padding-block: 6px;
    }

    /* The contact icons sit right below, so the page links leave Get in Touch out */
    .wordmark,
    .nav-contact {
      display: none;
    }

    .footer-nav ul {
      justify-content: space-between;
      gap: 6px;
    }

    .footer-contact {
      margin-left: -4px;
    }
  }

  /* Narrow and not tall: two lines (the header menu still has the page links) */
  @media (max-width: 860px) and (max-height: 739px) {
    .footer-inner {
      grid-template-areas:
        'contact terms'
        'legal   legal';
    }

    .footer-nav {
      display: none;
    }
  }

  /* Narrow and short (a phone on its side): one line */
  @media (max-width: 860px) and (max-height: 519px) {
    .footer-inner {
      grid-template-columns: minmax(0, 1fr) auto auto;
      grid-template-areas: 'legal contact terms';
      padding-block: 3px;
    }

    .legal-rights {
      display: none;
    }
  }
</style>
