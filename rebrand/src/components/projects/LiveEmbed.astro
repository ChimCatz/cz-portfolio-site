---
// A live app hosted on its own site, inside the same browser-style frame as the
// dashboards. Until the visitor presses Start it is only a poster (the project's
// screenshot), so the page sends nothing to the other site and a drag or scroll
// over it still moves the page. Without the script, Start opens the app in a new tab.
import { Image } from 'astro:assets';

interface Props {
  url: string;
  label: string;
  poster?: ImageMetadata;
  posterAlt?: string;
}

const { url, label, poster, posterAlt = `${label}, screenshot` } = Astro.props;
const host = new URL(url).host;
---

<section class="live" data-live aria-label={`${label}, live`}>
  <div class="live-bar">
    <span class="live-dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="live-title">{label}</span>
    <a class="live-open" href={url} target="_blank" rel="noopener">
      Open full screen <span aria-hidden="true">↗</span>
    </a>
  </div>

  <div class="live-window" data-live-window>
    <a class="live-start" href={url} target="_blank" rel="noopener" data-live-start data-label={label}>
      {poster && (
        <Image src={poster} alt={posterAlt} widths={[720, 1080, 1440]} sizes="(max-width: 1200px) 100vw, 1100px" loading="eager" />
      )}
      <span class="live-play">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l10.5-6.5z" /></svg>
        Start {label}
      </span>
    </a>
  </div>

  <div class="live-actions">
    <!-- On phones the bar has no room for this link, so it sits here instead. -->
    <a class="btn btn-ghost" href={url} target="_blank" rel="noopener">
      Open full screen <span aria-hidden="true">↗</span>
    </a>
  </div>

  <p class="live-caption">
    Runs live from its own site, {host}. Nothing loads from it until you press Start.
  </p>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-live]').forEach((live) => {
    const start = live.querySelector<HTMLAnchorElement>('[data-live-start]');
    const win = live.querySelector<HTMLElement>('[data-live-window]');
    if (!start || !win) return;

    start.addEventListener('click', (event) => {
      // Let modified clicks (new tab, new window) open the app as a link would.
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return;
      event.preventDefault();
      const frame = document.createElement('iframe');
      frame.src = start.href;
      frame.title = start.dataset.label ?? '';
      frame.allow = 'fullscreen';
      start.replaceWith(frame);
      live.classList.add('is-running');
      frame.focus();

      // Two animated globes at once is one too many: while the app is on screen,
      // the background globe (barely visible behind the veil here) holds still.
      if ('IntersectionObserver' in window) {
        new IntersectionObserver(([entry]) => {
          const type = entry.isIntersecting ? 'globe:pause' : 'globe:resume';
          document.dispatchEvent(new CustomEvent(type, { detail: 'live-embed' }));
        }).observe(frame);
      }
    });
  });
</script>

<style>
  .live {
    margin-top: clamp(28px, 4vh, 40px);
  }

  /* Browser-style frame, as on the dashboards */
  .live-bar {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 46px;
    padding: 6px 14px;
    border: 1px solid var(--line-strong);
    border-bottom: 0;
    border-radius: var(--radius) var(--radius) 0 0;
    background: rgba(19, 15, 31, 0.92);
  }

  .live-dots {
    display: flex;
    flex: none;
    gap: 6px;
  }

  .live-dots i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--line-strong);
  }

  .live-title {
    min-width: 0;
    overflow: hidden;
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 500;
    white-space: nowrap;
    text-overflow: ellipsis;
    color: var(--text-muted);
  }

  .live-open {
    flex: none;
    margin-left: auto;
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 600;
    white-space: nowrap;
    text-decoration: none;
    color: var(--purple-300);
    transition: color 0.2s;
  }

  .live-open:hover {
    color: var(--text);
  }

  /* 16:9 on wide screens (never taller than most of the screen), tall on phones */
  .live-window {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    max-height: 80vh;
    width: 100%;
    border: 1px solid var(--line-strong);
    border-radius: 0 0 var(--radius) var(--radius);
    background: #120f3a;
    box-shadow: 0 24px 60px -28px var(--glow);
  }

  /* Created by the script, so it has no scoped-style attribute */
  .live-window :global(iframe) {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* The poster: the screenshot, dimmed, with a Start button over it */
  .live-start {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    text-decoration: none;
    cursor: pointer;
  }

  .live-start img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.7);
    transition: filter 0.3s;
  }

  .live-start:hover img,
  .live-start:focus-visible img {
    filter: brightness(0.85);
  }

  .live-play {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 26px 14px 20px;
    border-radius: 999px;
    background: var(--brand-gradient);
    box-shadow: 0 12px 40px -10px var(--glow);
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
    color: #fff;
    transition: transform 0.2s;
  }

  .live-start:hover .live-play {
    transform: scale(1.04);
  }

  .live-play svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }

  .live-actions {
    display: none;
    justify-content: center;
    margin-top: 16px;
  }

  .live-actions .btn {
    background: rgba(13, 10, 22, 0.72);
  }

  .live-caption {
    margin-top: 12px;
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--text-muted);
  }

  @media (max-width: 600px) {
    .live-bar {
      gap: 10px;
      padding-inline: 12px;
    }

    .live-dots,
    .live-bar .live-open {
      display: none;
    }

    .live-actions {
      display: flex;
    }

    /* Portrait: the app turns its side panel into a bottom sheet, so give it height */
    .live-window {
      aspect-ratio: auto;
      height: min(72svh, 620px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .live-start img,
    .live-play {
      transition: none;
    }
  }
</style>
