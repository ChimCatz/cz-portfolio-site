---
// Full-page animated globe background (Vanta.js GLOBE effect, MIT).
// three.js r134 and the effect are self-hosted in public/vendor/vanta/.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div id="globe-bg" aria-hidden="true"></div>

<script is:inline defer src={`${base}/vendor/vanta/three.r134.min.js`}></script>
<script is:inline defer src={`${base}/vendor/vanta/vanta.globe.min.js`}></script>
<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    // Respect reduced-motion: keep the plain dark background instead.
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (!window.VANTA || !window.VANTA.GLOBE) return;

    window.VANTA.GLOBE({
      el: '#globe-bg',
      mouseControls: true,
      touchControls: true,
      gyroControls: false,
      minHeight: 200,
      minWidth: 200,
      scale: 1,
      scaleMobile: 1,
      size: 1,
      color: 0x8b5cf6, // lines: violet
      color2: 0xc4b5fd, // dots: soft lilac
      backgroundColor: 0x07050c, // matches --bg
    });
  });
</script>

<style>
  #globe-bg {
    position: fixed;
    inset: 0;
    z-index: -2; /* below the purple glow (body::before, z-index -1) */
    pointer-events: none;
  }
</style>
